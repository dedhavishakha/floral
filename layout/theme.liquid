<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{% render 'text-direction' %}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    {%- for scheme in settings.color_schemes -%}<meta name="theme-color" content="{{ scheme.settings.background }}">{%- break -%}{%- endfor -%}
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_heading_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    <title>
      {{- page_title -}}
      {%- if current_tags -%}{%- assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags }}{%- endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {%- unless settings.type_body_font.system? -%}
      {{ settings.type_body_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    {%- endunless -%}
    {%- unless settings.type_heading_font.system? -%}
      {{ settings.type_heading_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    {%- endunless -%}

    {% render 'css-variables' %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'components.css' | asset_url | stylesheet_tag }}
    {{ 'sections.css' | asset_url | stylesheet_tag }}
    {%- case template.name -%}
      {%- when 'product' -%}
        {{ 'product.css' | asset_url | stylesheet_tag }}
      {%- when 'collection', 'search' -%}
        {{ 'collection.css' | asset_url | stylesheet_tag }}
      {%- when 'blog', 'article', 'page', '404', 'cart', 'list-collections', 'password' -%}
        {{ 'pages.css' | asset_url | stylesheet_tag }}
    {%- endcase -%}
    {%- if template.directory == 'customers' -%}
      {{ 'pages.css' | asset_url | stylesheet_tag }}
    {%- endif -%}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }},
          search: {{ routes.search_url | json }},
          productRecommendations: {{ routes.product_recommendations_url | json }}
        },
        settings: {
          cartType: {{ settings.cart_type | json }},
          predictiveSearch: {{ settings.predictive_search | json }},
          shopCurrency: {{ shop.currency | json }},
          locale: {{ request.locale.iso_code | json }}
        },
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          addedToCart: {{ 'cart.general.added' | t | json }},
          cartEditNote: {{ 'cart.general.edit_note' | t | json }},
          cartError: {{ 'cart.general.error' | t | json }},
          loading: {{ 'general.accessibility.loading' | t | json }}
        }
      };
    </script>

    <script>
      window.theme.scripts = {
        product: {{ 'product.js' | asset_url | json }},
        sections: {{ 'sections.js' | asset_url | json }},
        compare: {{ 'compare.js' | asset_url | json }},
        wishlist: {{ 'wishlist.js' | asset_url | json }}
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    {%- if template.name == 'collection' or template.name == 'search' -%}
      <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handleize }}{% if template.suffix != blank %} template-{{ template.name | handleize }}--{{ template.suffix | handleize }}{% endif %}{% if settings.animations_reveal %} has-reveal reveal-{{ settings.animations_style }}{% endif %} hover-{{ settings.animations_hover }} speed-{{ settings.animations_speed }}">
    {%- liquid
      assign base_scheme = 'scheme-1'
      for scheme in settings.color_schemes
        assign base_scheme = scheme.id
        break
      endfor
    -%}
    <a class="skip-link button" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}
    {% render 'search-modal' %}

    <dialog id="QuickView" class="modal modal--quick-view color-{{ base_scheme }}" aria-label="{{ 'products.quick_view.label' | t }}">
      <button type="button" class="modal__close icon-button" data-dialog-close aria-label="{{ 'general.accessibility.close' | t }}">
        {%- render 'icon', icon: 'close' -%}
      </button>
      <div class="modal__content" data-quick-view-content></div>
    </dialog>

    {%- if settings.card_show_compare -%}
      <compare-tray class="compare-tray color-{{ base_scheme }}" hidden data-modal="CompareModal">
        <div class="compare-tray__inner page-width">
          <p class="compare-tray__title" id="CompareTrayTitle">
            {{- 'products.compare.tray_title' | t }}
            <span class="compare-tray__count" data-compare-count></span>
          </p>
          <ul class="compare-tray__list" id="CompareTrayList" role="list" aria-labelledby="CompareTrayTitle" data-compare-list></ul>
          <div class="compare-tray__actions">
            <button type="button" class="link compare-tray__clear" data-compare-clear>{{ 'products.compare.clear' | t }}</button>
            <button type="button" class="button button--small compare-tray__open" data-compare-open aria-haspopup="dialog" aria-describedby="CompareTrayHint">
              {{- 'products.compare.open' | t -}}
            </button>
            <button
              type="button"
              class="icon-button compare-tray__collapse"
              data-compare-collapse
              aria-expanded="true"
              aria-controls="CompareTrayList"
              aria-label="{{ 'products.compare.collapse' | t }}"
            >
              {%- render 'icon', icon: 'chevron-down' -%}
            </button>
          </div>
          <p class="compare-tray__hint" id="CompareTrayHint" data-compare-hint>{{ 'products.compare.hint' | t }}</p>
        </div>
        <p class="visually-hidden" aria-live="polite" data-compare-status></p>
      </compare-tray>
      <dialog id="CompareModal" class="modal modal--compare color-{{ base_scheme }}" aria-labelledby="CompareModalTitle">
        <button type="button" class="modal__close icon-button" data-dialog-close aria-label="{{ 'general.accessibility.close' | t }}">
          {%- render 'icon', icon: 'close' -%}
        </button>
        <div class="modal__content compare-modal">
          <h2 id="CompareModalTitle" class="h3">{{ 'products.compare.title' | t }}</h2>
          <div class="compare-modal__table" data-compare-table></div>
        </div>
      </dialog>
      <script type="application/json" id="CompareStrings">
        {
          "remove": {{ 'products.compare.remove' | t | json }},
          "price": {{ 'products.compare.price' | t | json }},
          "vendor": {{ 'products.compare.vendor' | t | json }},
          "type": {{ 'products.compare.type' | t | json }},
          "availability": {{ 'products.compare.availability' | t | json }},
          "inStock": {{ 'products.compare.in_stock' | t | json }},
          "soldOut": {{ 'products.product.sold_out' | t | json }},
          "description": {{ 'products.compare.description' | t | json }},
          "product": {{ 'products.compare.product' | t | json }},
          "view": {{ 'products.compare.view' | t | json }},
          "max": {{ 'products.compare.max' | t | json }},
          "added": {{ 'products.compare.added' | t | json }},
          "removed": {{ 'products.compare.removed' | t | json }},
          "emptySlot": {{ 'products.compare.empty_slot' | t | json }},
          "chooseOptions": {{ 'products.card.choose_options' | t | json }},
          "error": {{ 'products.compare.error' | t | json }},
          "collapse": {{ 'products.compare.collapse' | t | json }},
          "expand": {{ 'products.compare.expand' | t | json }}
        }
      </script>
    {%- endif -%}

    {%- if settings.wishlist_enable -%}
      <dialog id="WishlistDrawer" class="drawer drawer--right color-{{ base_scheme }}" aria-labelledby="WishlistDrawerTitle">
        <wishlist-drawer class="wishlist-drawer">
          <div class="drawer__header">
            <h2 id="WishlistDrawerTitle" class="drawer__title h4" tabindex="-1" data-wishlist-heading>
              {{- 'products.wishlist.title' | t -}}
              <span class="drawer__count" aria-hidden="true">(<span data-wishlist-total>0</span>)</span>
            </h2>
            <button type="button" class="icon-button" data-dialog-close aria-label="{{ 'general.accessibility.close' | t }}">
              {%- render 'icon', icon: 'close' -%}
            </button>
          </div>
          <div class="drawer__body">
            <ul class="wishlist-drawer__list" role="list" aria-labelledby="WishlistDrawerTitle" data-wishlist-list hidden></ul>
            <div class="wishlist-drawer__empty" data-wishlist-empty>
              {%- render 'icon', icon: 'heart' -%}
              <p class="h4">{{ 'products.wishlist.empty' | t }}</p>
              <p class="text-muted">{{ 'products.wishlist.empty_text' | t }}</p>
              <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'cart.general.continue_shopping' | t }}</a>
            </div>
          </div>
          <p class="visually-hidden" aria-live="polite" data-wishlist-status></p>
        </wishlist-drawer>
      </dialog>
      <script type="application/json" id="WishlistStrings">
        {
          "added": {{ 'products.wishlist.added' | t | json }},
          "removed": {{ 'products.wishlist.removed' | t | json }},
          "addedToast": {{ 'products.wishlist.added_toast' | t | json }},
          "remove": {{ 'products.wishlist.remove' | t | json }},
          "addToCart": {{ 'products.product.add_to_cart' | t | json }},
          "chooseOptions": {{ 'products.card.choose_options' | t | json }},
          "soldOut": {{ 'products.product.sold_out' | t | json }},
          "addedToCart": {{ 'cart.general.added' | t | json }},
          "from": {{ 'products.wishlist.from' | t | json }},
          "countOne": {{ 'products.wishlist.count_one' | t | json }},
          "countOther": {{ 'products.wishlist.count_other' | t | json }}
        }
      </script>
    {%- endif -%}

    {%- if settings.back_to_top -%}
      <a href="#MainContent" class="back-to-top icon-button" data-back-to-top hidden>
        {%- render 'icon', icon: 'chevron-up' -%}
        <span class="visually-hidden">{{ 'general.accessibility.back_to_top' | t }}</span>
      </a>
    {%- endif -%}

    <dialog id="PageModal" class="modal modal--page color-{{ base_scheme }}" aria-labelledby="PageModalTitle">
      <button type="button" class="modal__close icon-button" data-dialog-close aria-label="{{ 'general.accessibility.close' | t }}">
        {%- render 'icon', icon: 'close' -%}
      </button>
      <div class="modal__content rte" data-page-modal-content></div>
    </dialog>

    <div class="toast" role="status" aria-live="polite" data-toast></div>
    <div class="visually-hidden" aria-live="polite" aria-atomic="true" data-live-region></div>
  </body>
</html>
