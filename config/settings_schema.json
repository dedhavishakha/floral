      },
      {
        "type": "select",
        "id": "heading_case",
        "label": "Text case",
        "options": [
          {
            "value": "none",
            "label": "Default"
          },
          {
            "value": "uppercase",
            "label": "Uppercase"
          }
        ],
        "default": "none"
      },
      {
        "type": "header",
        "content": "Body"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Font",
        "default": "instrument_sans_n4"
      },
      {
        "type": "range",
        "id": "body_scale",
        "label": "Size scale",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "header",
        "content": "Labels and navigation"
      },
      {
        "type": "select",
        "id": "label_case",
        "label": "Text case",
        "info": "Applies to buttons, badges, eyebrows and menu labels.",
        "options": [
          {
            "value": "none",
            "label": "Default"
          },
          {
            "value": "uppercase",
            "label": "Uppercase"
          }
        ],
        "default": "none"
      },
      {
        "type": "range",
        "id": "label_tracking",
        "label": "Letter spacing",
        "min": 0,
        "max": 20,
        "step": 1,
        "default": 0,
        "info": "Values are hundredths of an em."
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
