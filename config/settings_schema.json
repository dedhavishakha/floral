          },
          {
            "type": "color",
            "id": "text",
            "label": "Text",
            "default": "#141414"
          },
          {
            "type": "color",
            "id": "button",
            "label": "Primary button",
            "default": "#141414"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "Primary button label",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "secondary_button_label",
            "label": "Secondary button and links",
            "default": "#141414"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "Accent",
            "default": "#8A6D4B"
          },
          {
            "type": "color",
            "id": "surface",
            "label": "Cards and image backgrounds",
            "default": "#ECEAE5"
          }
        ],
        "role": {
          "text": "text",
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "links": "secondary_button_label",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "secondary_button_label",
          "secondary_button_border": "secondary_button_label"
        }
      },
      {
        "type": "header",
        "content": "Prices"
      },
      {
        "type": "color",
        "id": "color_sale_price",
        "label": "Sale price",
        "default": "#B23A2A"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Headings"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Font",
        "default": "instrument_sans_n5"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Size scale",
        "min": 80,
        "max": 150,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "range",
        "id": "heading_tracking",
        "label": "Letter spacing",
        "min": -6,
        "max": 20,
        "step": 1,
        "default": -2,
        "info": "Values are hundredths of an em."
      },
      {
        "type": "range",
        "id": "heading_line_height",
        "label": "Line height",
        "min": 80,
        "max": 140,
        "step": 5,
        "unit": "%",
