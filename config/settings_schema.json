        "min": 0,
        "max": 48,
        "step": 2,
        "unit": "px",
        "default": 16
      },
      {
        "type": "range",
        "id": "grid_gap_y",
        "label": "Grid vertical gap",
        "min": 8,
        "max": 80,
        "step": 4,
        "unit": "px",
        "default": 40
