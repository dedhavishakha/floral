        "min": 8,
        "max": 32,
        "step": 2,
        "unit": "px",
        "default": 16
      },
      {
        "type": "header",
        "content": "Spacing"
      },
      {
        "type": "range",
        "id": "spacing_sections",
        "label": "Space between sections",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "default": 0,
        "info": "Added on top of each section's own padding."
      },
      {
        "type": "range",
        "id": "spacing_mobile_scale",
        "label": "Mobile section spacing",
        "min": 40,
        "max": 100,
        "step": 5,
        "unit": "%",
        "default": 65,
        "info": "Section padding on mobile, as a share of desktop padding."
