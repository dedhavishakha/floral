{% layout none %}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_schemes.first.settings.background }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    {%- assign formatted_initial_value = gift_card.initial_value | money_without_trailing_zeros: gift_card.currency | strip_html -%}
    <title>{{ 'gift_cards.issued.title' | t: value: formatted_initial_value, shop: shop.name }}</title>
    <meta name="description" content="{{ 'gift_cards.issued.subtext' | t }}">

    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer="defer"></script>
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'pages.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body class="template-gift-card">
    <main class="section gift-card page-width page-width--narrow" id="MainContent" style="--pt: 32px; --pb: 64px;">
      <header class="gift-card__header">
        <a href="{{ shop.url }}" class="gift-card__shop h4">{{ shop.name | escape }}</a>
      </header>

      <div class="gift-card__card">
        <p class="eyebrow">{{ 'gift_cards.issued.subtext' | t }}</p>
        <h1 class="h1 gift-card__value">
          {%- if settings.currency_code_enabled -%}
            {{ gift_card.initial_value | money_with_currency }}
          {%- else -%}
            {{ gift_card.initial_value | money }}
          {%- endif -%}
        </h1>

        {%- if gift_card.enabled == false or gift_card.expired -%}
          <p class="badge badge--sold-out gift-card__status">
            {%- if gift_card.expired -%}{{ 'gift_cards.issued.expired' | t }}{%- else -%}{{ 'gift_cards.issued.disabled' | t }}{%- endif -%}
          </p>
        {%- endif -%}

        {%- if gift_card.balance != gift_card.initial_value -%}
          <p class="gift-card__balance">
            {%- assign balance_money = gift_card.balance | money -%}
            {{ 'gift_cards.issued.remaining_html' | t: balance: balance_money }}
          </p>
        {%- endif -%}

        {%- if gift_card.expires_on -%}
          {%- assign expiry_date = gift_card.expires_on | date: '%B %e, %Y' -%}
          <p class="text-muted">{{ 'gift_cards.issued.expiration_date' | t: expires_on: expiry_date }}</p>
        {%- endif -%}

        <div class="gift-card__code-row">
          <label class="visually-hidden" for="GiftCardCode">{{ 'gift_cards.issued.code_label' | t }}</label>
          <input id="GiftCardCode" class="field__input gift-card__code" type="text" value="{{ gift_card.code | format_code }}" readonly>
          <button type="button" class="button button--secondary" data-copy-code="{{ gift_card.code | format_code }}" data-copied="{{ 'gift_cards.issued.copy_success' | t }}">
            {{- 'gift_cards.issued.copy_code' | t -}}
          </button>
        </div>
        <p class="gift-card__copy-status text-small" role="status" aria-live="polite" data-copy-status></p>

        <div class="gift-card__qr" id="GiftCardQR" data-identifier="{{ gift_card.qr_identifier }}" aria-hidden="true"></div>
        <p class="text-small text-muted">{{ 'gift_cards.issued.how_to_use' | t }}</p>

        <div class="gift-card__actions">
          <a href="{{ shop.url }}" class="button">{{ 'gift_cards.issued.shop_link' | t }}</a>
          <button type="button" class="button button--secondary" onclick="window.print();">{{ 'gift_cards.issued.print' | t }}</button>
        </div>

        {%- if gift_card.pass_url -%}
          <a href="{{ gift_card.pass_url }}" class="gift-card__wallet">
            <img
              src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
              width="120"
              height="40"
              alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}"
              loading="lazy"
            >
          </a>
        {%- endif -%}
      </div>
    </main>

    <script>
      window.addEventListener('DOMContentLoaded', function () {
        var qr = document.getElementById('GiftCardQR');
        if (qr && window.QRCode) {
          new window.QRCode(qr, { text: qr.dataset.identifier, width: 120, height: 120, imageAltText: '' });
        }
        var button = document.querySelector('[data-copy-code]');
        var status = document.querySelector('[data-copy-status]');
        if (button && navigator.clipboard) {
          button.addEventListener('click', function () {
            navigator.clipboard.writeText(button.dataset.copyCode).then(function () {
              if (status) status.textContent = button.dataset.copied;
            });
          });
        }
      });
    </script>
  </body>
</html>
