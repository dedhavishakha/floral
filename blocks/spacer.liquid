<div
  class="block-spacer"
  style="--spacer-height: {{ block.settings.height }}px; --spacer-height-mobile: {{ block.settings.height_mobile }}px;"
  aria-hidden="true"
  {{ block.shopify_attributes }}
></div>

{% schema %}
{
  "name": "Spacer",
  "settings": [
    { "type": "range", "id": "height", "label": "Desktop height", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "height_mobile", "label": "Mobile height", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 }
  ],
  "presets": [{ "name": "Spacer" }]
}
{% endschema %}
