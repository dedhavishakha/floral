{%- liquid
  assign b = block.settings
  assign image_sizes = '(min-width: 990px) ' | append: b.width | append: 'vw, 100vw'
-%}
<div class="block-image" style="--block-width: {{ b.width }}%;" {{ block.shopify_attributes }}>
  {%- capture image_markup -%}
    <div class="media media--{{ b.ratio }}" style="--ratio: {{ b.image.aspect_ratio | default: 1.333 }};">
      {%- if b.image != blank -%}
        {%- assign block_alt = b.image.alt | escape -%}
        {{ b.image | image_url: width: 2400 | image_tag: widths: '400, 600, 900, 1200, 1600, 2400', sizes: image_sizes, loading: 'lazy', alt: block_alt }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  {%- endcapture -%}
  {%- if b.link != blank -%}
    <a href="{{ b.link }}" class="block-image__link">{{ image_markup }}</a>
  {%- else -%}
    {{ image_markup }}
  {%- endif -%}
  {%- if b.caption != blank -%}
    <p class="block-image__caption text-small text-muted">{{ b.caption | escape }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Image",
  "tag": null,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Shown in the shape set by Aspect ratio. Recommended: at least 1600 px wide." },
    {
      "type": "select",
      "id": "ratio",
      "label": "Aspect ratio",
      "options": [
        { "value": "natural", "label": "Natural" },
        { "value": "portrait", "label": "Portrait 3:4" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape 4:3" },
        { "value": "wide", "label": "Wide 16:9" }
      ],
      "default": "natural"
    },
    { "type": "range", "id": "width", "label": "Width", "min": 20, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "caption", "label": "Caption" }
  ],
  "presets": [{ "name": "Image" }]
}
{% endschema %}
