{% doc %}
  Renders numbered pagination with previous and next links.

  @param {object} paginate - The paginate object from a paginate tag
  @param {string} [anchor] - Optional anchor appended to page links, for example #MainContent

  @example
  {% render 'pagination', paginate: paginate %}
{% enddoc %}
{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="{{ 'pagination.label' | t }}">
    <ul class="pagination__list" role="list">
      {%- if paginate.previous -%}
        <li>
          <a href="{{ paginate.previous.url }}{{ anchor }}" class="pagination__item pagination__item--arrow" aria-label="{{ 'pagination.previous' | t }}">
            {%- render 'icon', icon: 'chevron-left' -%}
          </a>
        </li>
      {%- endif -%}
      {%- for part in paginate.parts -%}
        <li>
          {%- if part.is_link -%}
            <a href="{{ part.url }}{{ anchor }}" class="pagination__item" aria-label="{{ 'pagination.page' | t: number: part.title }}">{{ part.title }}</a>
          {%- elsif part.title == paginate.current_page -%}
            <span class="pagination__item" aria-current="page" aria-label="{{ 'pagination.page' | t: number: part.title }}">{{ part.title }}</span>
          {%- else -%}
            <span class="pagination__item pagination__item--gap">{{ part.title }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
      {%- if paginate.next -%}
        <li>
          <a href="{{ paginate.next.url }}{{ anchor }}" class="pagination__item pagination__item--arrow" aria-label="{{ 'pagination.next' | t }}">
            {%- render 'icon', icon: 'chevron-right' -%}
          </a>
        </li>
      {%- endif -%}
    </ul>
  </nav>
{%- endif -%}
