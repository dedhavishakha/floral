{% doc %}
  Renders one cart line with image, options, properties, discounts, quantity controls and price.
  Used by the cart drawer and the cart page.

  @param {line_item} item - The cart line item
  @param {number} index - The 1-based line number
  @param {string} [image_width] - Image display width in px. Defaults to 96

  @example
  {% render 'cart-line-item', item: item, index: forloop.index %}
{% enddoc %}
{%- liquid
  assign width = image_width | default: 96
  if settings.currency_code_enabled
    assign final_line = item.final_line_price | money_with_currency
  else
    assign final_line = item.final_line_price | money
  endif
-%}
<li class="cart-item" data-cart-item data-key="{{ item.key }}" style="--cart-image: {{ width }}px;">
  <a href="{{ item.url }}" class="cart-item__media" tabindex="-1" aria-hidden="true">
    {%- if item.image -%}
      {{
        item.image
        | image_url: width: 360
        | image_tag: widths: '120, 180, 240, 360', sizes: '120px', loading: 'lazy', class: 'cart-item__image', alt: ''
      }}
    {%- else -%}
      {{ 'product-apparel-1' | placeholder_svg_tag: 'cart-item__image placeholder-svg' }}
    {%- endif -%}
  </a>

  <div class="cart-item__details">
    {%- if settings.card_show_vendor -%}
      <p class="cart-item__vendor">{{ item.vendor | escape }}</p>
    {%- endif -%}
    <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title | escape }}</a>

    {%- unless item.product.has_only_default_variant -%}
      <p class="cart-item__meta">
        {%- for option in item.options_with_values -%}
          {{ option.name | escape }}: {{ option.value | escape }}{% unless forloop.last %}<span aria-hidden="true"> · </span>{% endunless %}
        {%- endfor -%}
      </p>
    {%- endunless -%}

    {%- if item.selling_plan_allocation -%}
      <p class="cart-item__meta">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
    {%- endif -%}

    {%- for property in item.properties -%}
      {%- assign property_first_char = property.first | slice: 0 -%}
      {%- if property.last != blank and property_first_char != '_' -%}
        <p class="cart-item__meta">
          {{ property.first | escape }}:
          {%- if property.last contains '/uploads/' -%}
            <a href="{{ property.last }}" class="link" target="_blank" rel="noopener">{{ property.last | split: '/' | last | escape }}</a>
          {%- else -%}
            {{ property.last | escape }}
          {%- endif -%}
        </p>
      {%- endif -%}
    {%- endfor -%}

    {%- for discount in item.line_level_discount_allocations -%}
      <p class="cart-item__discount">
        {%- render 'icon', icon: 'tag' -%}
        {{ discount.discount_application.title | escape }} (-{{ discount.amount | money }})
      </p>
    {%- endfor -%}

    <div class="cart-item__actions">
      <quantity-input class="quantity quantity--small">
        <button type="button" class="quantity__button" name="minus" aria-label="{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}">
          {%- render 'icon', icon: 'minus' -%}
        </button>
        <label class="visually-hidden" for="CartQuantity-{{ item.key | handleize }}">{{ 'products.product.quantity.label' | t }}</label>
        <input
          class="quantity__input"
          type="number"
          id="CartQuantity-{{ item.key | handleize }}"
          value="{{ item.quantity }}"
          min="0"
          step="{{ item.variant.quantity_rule.increment }}"
          {% if item.variant.quantity_rule.max != null %}max="{{ item.variant.quantity_rule.max }}"{% endif %}
          inputmode="numeric"
          data-cart-quantity
          data-key="{{ item.key }}"
          data-line="{{ index }}"
        >
        <button type="button" class="quantity__button" name="plus" aria-label="{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}">
          {%- render 'icon', icon: 'plus' -%}
        </button>
      </quantity-input>
      {%- if item.product.has_only_default_variant == false and item.selling_plan_allocation == nil and item.gift_card == false and item.properties == empty -%}
        <button
          type="button"
          class="cart-item__edit link"
          data-cart-edit="{{ item.url }}"
          data-key="{{ item.key }}"
          data-variant="{{ item.variant_id }}"
          data-quantity="{{ item.quantity }}"
          aria-haspopup="dialog"
        >
          {{- 'cart.general.edit' | t -}}
          <span class="visually-hidden">: {{ item.product.title | escape }}</span>
        </button>
      {%- endif -%}
      <button type="button" class="cart-item__remove link" data-cart-remove data-key="{{ item.key }}">
        {{- 'cart.general.remove' | t -}}
        <span class="visually-hidden">: {{ item.product.title | escape }}</span>
      </button>
    </div>
    <p class="cart-item__error" role="alert" data-line-error hidden></p>
  </div>

  <div class="cart-item__price">
    {%- if item.original_line_price != item.final_line_price -%}
      <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
      <s class="price__compare">{{ item.original_line_price | money }}</s>
      <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
    {%- endif -%}
    <span class="cart-item__final">{{ final_line }}</span>
    {%- if item.unit_price_measurement -%}
      <span class="price__unit">
        <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
        {{- item.unit_price | unit_price_with_measurement: item.unit_price_measurement -}}
      </span>
    {%- endif -%}
  </div>
</li>
