{% doc %}
  Renders an inline SVG icon from the theme's line icon set.

  @param {string} icon - Icon name, for example cart, search, close, chevron-down
  @param {string} [class] - Extra classes for the svg element

  @example
  {% render 'icon', icon: 'cart' %}
{% enddoc %}
