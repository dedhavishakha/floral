{%- endcapture -%}
<svg class="icon icon-{{ icon }}{% if class != blank %} {{ class }}{% endif %}" aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">{{ paths }}</svg>
