    {%- when 'snapchat' -%}<path d="M12 3.5c3 0 4.8 2.2 4.8 5v2.4l1.9-.6c.5.4.3 1-.4 1.3l-1.5.6c.7 2 2.2 3.3 4 3.8-.4.8-1.7 1-2.8 1.2l-.4 1.3-2.2-.2c-1.1.9-2.1 1.7-3.4 1.7s-2.3-.8-3.4-1.7l-2.2.2-.4-1.3c-1.1-.2-2.4-.4-2.8-1.2 1.8-.5 3.3-1.8 4-3.8l-1.5-.6c-.7-.3-.9-.9-.4-1.3l1.9.6V8.5c0-2.8 1.8-5 4.8-5z"/>
    {%- when 'threads' -%}<path d="M16.5 11.3c-.4-2.4-2-3.6-4.3-3.6-2.2 0-3.6 1.3-3.9 3.1M16.6 11.5c-2.6-.6-6.6-.4-6.4 2.1.2 2.2 4.2 2.3 5.4.2.6-1 .8-2.3.6-3.4M16.6 11.5c2.4 1.1 3 3.6 1.8 5.6-1.4 2.4-4 3.4-6.4 3.4-4.4 0-7.5-3.1-7.5-8.5S7.6 3.5 12 3.5c3.7 0 6.2 1.9 7.2 5"/>
