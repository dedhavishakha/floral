{%- liquid
  assign dialog_id = 'PasswordDialog-' | append: section.id
  assign password_error = false
-%}
<div
  class="section main-password color-{{ section.settings.color_scheme }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  {%- if section.settings.image != blank -%}
    <div class="password__media" aria-hidden="true">
      {{
        section.settings.image
        | image_url: width: 3000
        | image_tag: widths: '750, 1100, 1500, 2000, 3000', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: ''
      }}
      <span class="password__overlay" style="--overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></span>
    </div>
  {%- endif -%}

  <header class="password__header page-width">
    <span></span>
    {%- if section.settings.logo != blank -%}
      <span class="password__logo" style="--logo-width: {{ section.settings.logo_width }}px;">
        {%- assign logo_alt = section.settings.logo.alt | default: shop.name | escape -%}
        {{ section.settings.logo | image_url: width: 600 | image_tag: widths: '200, 300, 400, 600', sizes: '200px', alt: logo_alt }}
      </span>
    {%- else -%}
      <span class="password__shop h4">{{ shop.name | escape }}</span>
    {%- endif -%}
    <button type="button" class="link password__enter" data-dialog-open="{{ dialog_id }}" aria-haspopup="dialog">
      {%- render 'icon', icon: 'lock' -%}
      {{ 'password.general.enter_with_password' | t }}
    </button>
  </header>

  <div class="password__content page-width page-width--narrow">
    <div class="section-header section-header--center">
      <div class="section-header__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h1 class="h0 password__heading">{{ section.settings.heading | escape }}</h1>
        {%- if shop.password_message != blank -%}
          <p class="password__message text-large">{{ shop.password_message }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.show_newsletter -%}
      {%- assign newsletter_id = 'PasswordNewsletter-' | append: section.id -%}
      {%- form 'customer', id: newsletter_id, class: 'password__newsletter' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,password page">
        {%- if form.posted_successfully? -%}
          <p class="form-message" role="status" tabindex="-1" autofocus>
            {%- render 'icon', icon: 'check' -%}
            {{ 'password.newsletter.success' | t }}
          </p>
        {%- else -%}
          <label class="visually-hidden" for="{{ newsletter_id }}-email">{{ 'password.newsletter.label' | t }}</label>
          <div class="password__newsletter-row">
            <input
              id="{{ newsletter_id }}-email"
              class="field__input"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="{{ 'password.newsletter.placeholder' | t }}"
              autocomplete="email"
              autocapitalize="off"
              spellcheck="false"
              required
              aria-required="true"
              {% if form.errors %}aria-invalid="true" aria-describedby="{{ newsletter_id }}-error"{% endif %}
            >
            <button type="submit" class="button">{{ 'password.newsletter.submit' | t }}</button>
          </div>
          {%- if form.errors -%}
            <p class="field__error" id="{{ newsletter_id }}-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}

    {% render 'social-icons', class: 'password__social' %}
  </div>

  <footer class="password__footer page-width">
    <p class="text-small">&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</p>
    <p class="text-small">{{ powered_by_link }}</p>
  </footer>

  <dialog id="{{ dialog_id }}" class="modal password__dialog color-{{ section.settings.color_scheme }}" aria-labelledby="{{ dialog_id }}-title">
    <button type="button" class="modal__close icon-button" data-dialog-close aria-label="{{ 'general.accessibility.close' | t }}">
      {%- render 'icon', icon: 'close' -%}
    </button>
    <div class="modal__content password__login">
      <h2 id="{{ dialog_id }}-title" class="h3">{{ 'password.general.enter_with_password' | t }}</h2>
      {%- form 'storefront_password', class: 'password__form' -%}
        <div class="field">
          <label class="field__label" for="{{ dialog_id }}-password">{{ 'password.general.password' | t }}</label>
          <input
            id="{{ dialog_id }}-password"
            class="field__input"
            type="password"
            name="password"
            autocomplete="current-password"
            required
            {% if form.errors %}aria-invalid="true" aria-describedby="{{ dialog_id }}-error"{% endif %}
          >
          {%- if form.errors -%}
            {%- assign password_error = true -%}
            <p class="field__error" id="{{ dialog_id }}-error" role="alert">{{ form.errors.translated_fields.password | capitalize }} {{ form.errors.messages.password }}</p>
          {%- endif -%}
        </div>
        <button type="submit" class="button button--full">{{ 'password.general.enter' | t }}</button>
      {%- endform -%}
      <p class="text-small text-muted">{{ 'password.general.admin_link_html' | t }}</p>
    </div>
  </dialog>
  {%- if password_error -%}
    <script>
      document.getElementById({{ dialog_id | json }}).showModal();
    </script>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Recommended: transparent PNG or SVG, at least twice the logo width." },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 60, "max": 300, "step": 10, "unit": "px", "default": 140 },
    { "type": "image_picker", "id": "image", "label": "Background image", "info": "Recommended: 16:9 landscape, 2400 x 1350 px." },
    { "type": "range", "id": "overlay_opacity", "label": "Image overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 35 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Coming soon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something new is on its way" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show email signup", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ]
}
{% endschema %}
