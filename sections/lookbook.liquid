{%- liquid
  assign s = section.settings
  case s.look_width
    when 'narrow'
      assign cols = 4
      assign look_sizes = '(min-width: 990px) 25vw, (min-width: 750px) 40vw, 80vw'
    when 'wide'
      assign cols = 2
      assign look_sizes = '(min-width: 990px) 50vw, (min-width: 750px) 60vw, 80vw'
    else
      assign cols = 3
      assign look_sizes = '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 80vw'
  endcase
  assign cols_tablet = cols | at_most: 2
-%}
<div
  class="section lookbook color-{{ s.color_scheme }}"
  style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px;"
>
  <carousel-slider class="page-width carousel lookbook__carousel carousel--peek-{{ s.carousel_peek }}">
    <div class="section-header">
      <div class="section-header__text">
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.description != blank -%}<div class="rte">{{ s.description }}</div>{%- endif -%}
      </div>
      <div class="section-header__actions">
        <div class="carousel__nav">
          <button type="button" class="icon-button icon-button--bordered" data-carousel-prev aria-label="{{ 'general.accessibility.previous_slide' | t }}">
            {%- render 'icon', icon: 'chevron-left' -%}
          </button>
          <button type="button" class="icon-button icon-button--bordered" data-carousel-next aria-label="{{ 'general.accessibility.next_slide' | t }}">
            {%- render 'icon', icon: 'chevron-right' -%}
          </button>
        </div>
      </div>
    </div>

    <ul
      class="carousel__track lookbook__track"
      data-carousel-track
      role="list"
      style="--cols-desktop: {{ cols }}; --cols-tablet: {{ cols_tablet }}; --cols-mobile: 1;"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign placeholder_number = forloop.index | modulo: 4 | plus: 1
          assign placeholder_name = 'collection-apparel-' | append: placeholder_number
          assign look_count = 0
          if b.product_1 != blank
            assign look_count = look_count | plus: 1
          endif
          if b.product_2 != blank
            assign look_count = look_count | plus: 1
          endif
          if b.product_3 != blank
            assign look_count = look_count | plus: 1
          endif
        -%}
        <li class="look" {{ block.shopify_attributes }}>
          <figure class="look__figure">
            <div class="look__media media media--{{ s.image_ratio }} media--size-{{ s.image_size }}" style="--ratio: {{ b.image.aspect_ratio | default: 0.75 }};">
              {%- if b.image != blank -%}
                {%- assign look_alt = b.image.alt | default: b.title | escape -%}
                {{ b.image | image_url: width: 1600 | image_tag: widths: '400, 600, 800, 1000, 1300, 1600', sizes: look_sizes, loading: 'lazy', alt: look_alt }}
              {%- else -%}
                {{ placeholder_name | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
              <span class="look__number" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            </div>
            <figcaption class="look__info">
              {%- if b.title != blank -%}
                <h3 class="look__title h4">{{ b.title | escape }}</h3>
              {%- endif -%}
              {%- if b.caption != blank -%}
                <div class="look__caption rte">{{ b.caption }}</div>
              {%- endif -%}
            </figcaption>
          </figure>
          {%- if look_count > 0 -%}
            <ul class="look__products" role="list" aria-label="{{ 'sections.lookbook.shop_look' | t }}">
              {%- for i in (1..3) -%}
                {%- assign product_key = 'product_' | append: i -%}
                {%- assign look_product = b[product_key] -%}
                {%- if look_product != blank -%}
                <li>
                  <button type="button" class="look__product" data-quick-view="{{ look_product.url }}" aria-haspopup="dialog">
                    <span class="look__product-title">{{ look_product.title | escape }}</span>
                    <span class="look__product-price">{{ look_product.price | money }}</span>
                    {%- render 'icon', icon: 'plus' -%}
                  </button>
                </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    {%- if s.show_progress -%}<div class="carousel__progress" aria-hidden="true"><span class="carousel__progress-bar"></span></div>{%- endif -%}
  </carousel-slider>
</div>

{% schema %}
{
  "name": "Lookbook",
  "tag": "section",
  "class": "section-lookbook",
  "max_blocks": 12,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Lookbook" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Autumn, styled" },
    { "type": "richtext", "id": "description", "label": "Description" },
    {
      "type": "select",
      "id": "look_width",
      "label": "Looks per row on desktop",
      "options": [
        { "value": "narrow", "label": "4" },
        { "value": "medium", "label": "3" },
        { "value": "wide", "label": "2" }
      ],
      "default": "medium"
    },
    { "type": "checkbox", "id": "carousel_peek", "label": "Show part of the next item", "default": true },
    { "type": "checkbox", "id": "show_progress", "label": "Show progress bar", "default": true },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "portrait", "label": "Portrait 3:4" },
        { "value": "tall", "label": "Tall 2:3" },
        { "value": "portrait-45", "label": "Portrait 4:5" },
        { "value": "natural", "label": "Original image ratio" }
      ],
      "default": "tall"
    },
    {
      "type": "select",
      "id": "image_size",
      "label": "Image size",
      "options": [
        { "value": "original", "label": "Original image ratio" },
        { "value": "ratio", "label": "Use image ratio" },
        { "value": "x-small", "label": "X-Small" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "ratio",
      "info": "Original image ratio shows each image uncropped in its own shape. X-Small to Large show every image at the same height and crop to fit. Use image ratio keeps the shape chosen above."
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Shown in the shape set by Image ratio. Recommended: 2:3 portrait, 1200 x 1800 px." },
        { "type": "text", "id": "title", "label": "Title", "default": "Look title" },
        { "type": "richtext", "id": "caption", "label": "Caption" },
        { "type": "header", "content": "Products in this look" },
        { "type": "product", "id": "product_1", "label": "Product 1" },
        { "type": "product", "id": "product_2", "label": "Product 2" },
        { "type": "product", "id": "product_3", "label": "Product 3" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook",
      "blocks": [
        { "type": "look", "settings": { "title": "City layers" } },
        { "type": "look", "settings": { "title": "Weekend knit" } },
        { "type": "look", "settings": { "title": "Evening tailoring" } },
        { "type": "look", "settings": { "title": "Off duty" } }
      ]
    }
  ]
}
{% endschema %}
