{%- assign s = section.settings -%}
<div
  class="section editorial-grid-section color-{{ s.color_scheme }}{% unless s.image_zoom %} zoom-off{% endunless %}"
  style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px;"
>
  <div class="page-width{% if s.full_width %} page-width--full page-width--flush{% endif %}">
    {%- if s.heading != blank or s.eyebrow != blank -%}
      <div class="section-header{% if s.header_alignment == 'center' %} section-header--center{% endif %}{% if s.full_width %} page-width{% endif %}">
        <div class="section-header__text">
          {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading }}</h2>{%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div
      class="editorial-grid editorial-grid--m-{{ s.mobile_layout }}"
      style="--eg-gap-x: {{ s.gap_x }}px; --eg-gap-y: {{ s.gap_y }}px; --eg-gap-x-m: {{ s.gap_x_mobile }}px; --eg-gap-y-m: {{ s.gap_y_mobile }}px;"
    >
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial grid",
  "tag": "section",
  "class": "section-editorial-grid",
  "max_blocks": 16,
  "blocks": [{ "type": "_editorial-item" }],
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Stories from the studio" },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "start"
    },
    { "type": "header", "content": "Grid" },
    {
      "type": "paragraph",
      "content": "Add grid items and place each one on the grid: desktop has 12 columns, mobile has 6. Each item holds images, headings, text and buttons."
    },
    {
      "type": "select",
      "id": "align_items",
      "label": "Vertical alignment",
      "options": [
        { "value": "start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Bottom" },
        { "value": "stretch", "label": "Fill row height" }
      ],
      "default": "stretch",
      "info": "How items in the same row line up. Fill row height stretches images so rows have no gaps. Each item can override it."
    },
    { "type": "range", "id": "gap_x", "label": "Horizontal spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "gap_y", "label": "Vertical spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 16 },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
    { "type": "checkbox", "id": "image_zoom", "label": "Zoom images on hover", "info": "Works when Theme settings > Animations > Image hover effect uses zoom.", "default": true },
    { "type": "header", "content": "Mobile" },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Swipeable carousel" },
        { "value": "stack", "label": "One per row" }
      ],
      "default": "grid",
      "info": "Grid uses each item's mobile settings. The carousel and one per row show the items in order."
    },
    { "type": "range", "id": "gap_x_mobile", "label": "Horizontal spacing", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 10 },
    { "type": "range", "id": "gap_y_mobile", "label": "Vertical spacing", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 10 },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [
    {
      "name": "Editorial grid",
      "blocks": [
        {
          "type": "_editorial-item",
          "settings": { "span": 6, "rows": 2, "mobile_span": 6, "text_on_image": true },
          "blocks": [
            { "type": "_editorial-image" },
            { "type": "heading", "settings": { "eyebrow": "Campaign", "heading": "Quiet luxury, everyday", "size": "h2", "alignment": "left", "max_width": 22 } },
            { "type": "button", "settings": { "label": "Discover", "style": "link" } }
          ]
        },
        {
          "type": "_editorial-item",
          "settings": { "span": 3, "rows": 2, "mobile_span": 3, "mobile_rows": 2, "text_on_image": true },
          "blocks": [
            { "type": "_editorial-image" },
            { "type": "heading", "settings": { "heading": "The linen shirt", "size": "h4", "alignment": "left" } }
          ]
        },
        {
          "type": "_editorial-item",
          "settings": { "span": 3, "mobile_span": 3, "text_on_image": true },
          "blocks": [
            { "type": "_editorial-image" },
            { "type": "heading", "settings": { "heading": "Soft tailoring", "size": "h4", "alignment": "left" } }
          ]
        },
        {
          "type": "_editorial-item",
          "settings": { "span": 3, "mobile_span": 3, "text_on_image": true },
          "blocks": [
            { "type": "_editorial-image" },
            { "type": "heading", "settings": { "heading": "Weekend layers", "size": "h4", "alignment": "left" } }
          ]
        }
      ]
    },
    {
      "name": "Image collage",
      "settings": { "heading": "", "align_items": "start", "gap_x": 24 },
      "blocks": [
        {
          "type": "_editorial-item",
          "settings": { "position": "custom", "row": 1, "column": 1, "span": 5, "mobile_position": "custom", "mobile_row": 1, "mobile_column": 1, "mobile_span": 4 },
          "blocks": [{ "type": "_editorial-image", "settings": { "ratio": "portrait", "caption": "The new season" } }]
        },
        {
          "type": "_editorial-item",
          "settings": { "position": "custom", "row": 1, "column": 7, "span": 3, "shift_y": 18, "mobile_position": "custom", "mobile_row": 2, "mobile_column": 3, "mobile_span": 4, "mobile_shift_y": -30, "bring_to_front": true },
          "blocks": [{ "type": "_editorial-image", "settings": { "ratio": "portrait" } }]
        },
        {
          "type": "_editorial-item",
          "settings": { "position": "custom", "row": 1, "column": 10, "span": 3, "vertical_alignment": "end", "mobile_position": "custom", "mobile_row": 3, "mobile_column": 1, "mobile_span": 6 },
          "blocks": [
            { "type": "heading", "settings": { "eyebrow": "Lookbook", "heading": "Made to be lived in", "size": "h3", "alignment": "left" } },
            { "type": "text", "settings": { "text": "<p>Easy shapes in natural fabrics, styled for the way you actually dress.</p>", "alignment": "left" } },
            { "type": "button", "settings": { "label": "Explore the edit", "style": "secondary" } }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
