<div
  class="section contact-section color-{{ section.settings.color_scheme }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width page-width--narrow">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="section-header section-header--center">
        <div class="section-header__text">
          {%- if section.settings.heading != blank -%}
            <h2 class="h2">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="rte">{{ section.settings.text }}</div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- assign contact_form_id = 'ContactForm-' | append: section.id -%}
    {%- form 'contact', id: contact_form_id, class: 'contact-form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message contact-form__status" role="status" tabindex="-1" autofocus>
          {%- render 'icon', icon: 'check' -%}
          {{ 'contact.form.success' | t }}
        </p>
      {%- elsif form.errors -%}
        <div class="form-message form-message--error contact-form__status" role="alert" tabindex="-1" autofocus>
          <p>{{ 'contact.form.error_heading' | t }}</p>
          <ul>
            {%- for field in form.errors -%}
              <li>
                {%- if field == 'form' -%}
                  {{ form.errors.messages[field] }}
                {%- else -%}
                  <a href="#{{ contact_form_id }}-{{ field }}" class="link">{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="contact-form__row">
        <div class="field">
          <label class="field__label" for="{{ contact_form_id }}-name">{{ 'contact.form.name' | t }}</label>
          <input class="field__input" type="text" id="{{ contact_form_id }}-name" name="contact[{{ 'contact.form.name' | t }}]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" autocomplete="name">
        </div>
        <div class="field">
          <label class="field__label" for="{{ contact_form_id }}-email">{{ 'contact.form.email' | t }} <span aria-hidden="true">*</span></label>
          <input
            class="field__input"
            type="email"
            id="{{ contact_form_id }}-email"
            name="contact[email]"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            autocomplete="email"
            autocapitalize="off"
            spellcheck="false"
            required
            aria-required="true"
            {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="{{ contact_form_id }}-email-error"{% endif %}
          >
          {%- if form.errors contains 'email' -%}
            <p class="field__error" id="{{ contact_form_id }}-email-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- endif -%}
        </div>
      </div>
      {%- if section.settings.show_phone -%}
        <div class="field">
          <label class="field__label" for="{{ contact_form_id }}-phone">{{ 'contact.form.phone' | t }}</label>
          <input class="field__input" type="tel" id="{{ contact_form_id }}-phone" name="contact[{{ 'contact.form.phone' | t }}]" value="{{ form.phone }}" autocomplete="tel" pattern="[0-9\-\+\s\(\)]*">
        </div>
      {%- endif -%}
      <div class="field">
        <label class="field__label" for="{{ contact_form_id }}-body">{{ 'contact.form.comment' | t }}</label>
        <textarea class="field__input" id="{{ contact_form_id }}-body" name="contact[{{ 'contact.form.comment' | t }}]" rows="6">{{ form.body }}</textarea>
      </div>
      <button type="submit" class="button">{{ 'contact.form.send' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in touch" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Questions about sizing, an order or a return? We reply within one working day.</p>" },
    { "type": "checkbox", "id": "show_phone", "label": "Show phone field", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
