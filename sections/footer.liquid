<footer class="footer footer--{{ section.settings.layout }} section color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    {%- assign band_html = '' -%}
    {%- capture blocks_html -%}
        {%- for block in section.blocks -%}
          {%- capture block_html -%}
          <div class="footer__block footer__block--{{ block.type }}" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'brand' -%}
                {%- if block.settings.logo != blank -%}
                  {%- assign footer_logo_alt = block.settings.logo.alt | default: shop.name | escape -%}
                  {%- assign footer_logo_2x = block.settings.logo_width | times: 2 -%}
                  <a href="{{ routes.root_url }}" class="footer__logo" style="--footer-logo-width: {{ block.settings.logo_width }}px;">
                    {{ block.settings.logo | image_url: width: footer_logo_2x | image_tag: loading: 'lazy', alt: footer_logo_alt }}
                  </a>
                {%- else -%}
                  <a href="{{ routes.root_url }}" class="footer__logo-text h3">{{ shop.name }}</a>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="footer__text rte">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- if block.settings.show_social -%}
                  {% render 'social-icons', class: 'footer__social' %}
                {%- endif -%}

              {%- when 'link_list' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.menu != blank -%}
                  <ul class="footer__links" role="list">
                    {%- for link in block.settings.menu.links -%}
                      <li>
                        <a href="{{ link.url }}" class="footer__link"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

              {%- when 'text' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                <div class="footer__text rte">{{ block.settings.text }}</div>

              {%- when 'newsletter' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading footer__heading--large">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="footer__text rte">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- assign newsletter_id = 'FooterNewsletter-' | append: block.id -%}
                {%- form 'customer', id: newsletter_id, class: 'footer-newsletter' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  {%- if form.posted_successfully? -%}
                    <p class="form-message" role="status" tabindex="-1" autofocus>
                      {%- render 'icon', icon: 'check' -%}
                      {{ 'newsletter.success' | t }}
                    </p>
                  {%- else -%}
                    <div class="footer-newsletter__row">
                      <label class="visually-hidden" for="{{ newsletter_id }}-email">{{ 'newsletter.label' | t }}</label>
                      <input
                        id="{{ newsletter_id }}-email"
                        class="field__input footer-newsletter__input"
                        type="email"
                        name="contact[email]"
                        autocomplete="email"
                        placeholder="{{ 'newsletter.placeholder' | t }}"
                        required
                        {% if form.errors %}aria-invalid="true" aria-describedby="{{ newsletter_id }}-error"{% endif %}
                      >
                      <button type="submit" class="button footer-newsletter__button" aria-label="{{ 'newsletter.button' | t }}">
                        {%- render 'icon', icon: 'arrow-right' -%}
                      </button>
                    </div>
                    {%- if form.errors -%}
                      <p id="{{ newsletter_id }}-error" class="field__error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
                    {%- endif -%}
                  {%- endif -%}
                {%- endform -%}
            {%- endcase -%}
          </div>
          {%- endcapture -%}
          {%- if section.settings.layout == 'newsletter_top' and block.type == 'newsletter' -%}
            {%- assign band_html = block_html -%}
          {%- else -%}
            {{ block_html }}
          {%- endif -%}
        {%- endfor -%}
    {%- endcapture -%}
    {%- if band_html != blank -%}
      <div class="footer__band">{{ band_html }}</div>
    {%- endif -%}
    {%- if blocks_html != blank -%}
      <div class="footer__blocks">{{ blocks_html }}</div>
    {%- endif -%}

    <div class="footer__bottom">
      <div class="footer__bottom-start">
        {% render 'localization-form', id_suffix: 'footer', show_country: section.settings.show_country, show_language: section.settings.show_language, class: 'footer__localization' %}
        {%- if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}
          <div class="footer__follow">{{ shop | login_button: action: 'follow' }}</div>
        {%- endif -%}
        <p class="footer__copyright">
          &copy; {{ 'now' | date: '%Y' }}, {{ shop.name | link_to: routes.root_url }}
          {%- if section.settings.copyright_text != blank %} &middot; {{ section.settings.copyright_text }}{%- endif -%}
          {%- if section.settings.show_powered_by %} &middot; {{ powered_by_link }}{%- endif -%}
        </p>
        {%- if section.settings.show_policies and shop.policies.size > 0 -%}
          <ul class="footer__policies" role="list">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <div class="footer__payments">
          <span class="visually-hidden">{{ 'sections.footer.payment_methods' | t }}</span>
          <ul class="footer__payment-list" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "footer-section",
  "enabled_on": { "groups": ["footer"] },
  "max_blocks": 8,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "columns", "label": "Columns" },
        { "value": "newsletter_top", "label": "Newsletter band on top" },
        { "value": "centered", "label": "Centered" }
      ],
      "default": "columns"
    },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "checkbox", "id": "show_policies", "label": "Show policy links", "info": "Add policies in Settings > Policies.", "default": true },
    { "type": "checkbox", "id": "show_country", "label": "Show country/region selector", "default": true },
    { "type": "checkbox", "id": "show_language", "label": "Show language selector", "default": true },
    { "type": "inline_richtext", "id": "copyright_text", "label": "Extra copyright text" },
    { "type": "checkbox", "id": "enable_follow_on_shop", "label": "Show Follow on Shop", "info": "Lets customers follow your store in the Shop app. Requires Shop Pay.", "default": true },
    { "type": "checkbox", "id": "show_powered_by", "label": "Show \"Powered by Shopify\"", "default": false },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 32 }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Recommended: transparent PNG or SVG, at least twice the logo width (e.g. 300 px wide)." },
        { "type": "range", "id": "logo_width", "label": "Logo width", "min": 50, "max": 300, "step": 5, "unit": "px", "default": 140 },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Considered clothing made in small runs, designed to be worn for years.</p>" },
        { "type": "checkbox", "id": "show_social", "label": "Show social media icons", "info": "Add links in Theme settings > Social media.", "default": true }
      ]
    },
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Visit us" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Open Tuesday to Sunday, 11am to 7pm.</p>" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Join the list" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>New arrivals, restocks and early access to the sale.</p>" },
        { "type": "paragraph", "content": "Subscribers are added to your customers with the newsletter tag." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [{ "type": "brand" }, { "type": "link_list" }, { "type": "newsletter" }]
    }
  ]
}
{% endschema %}
