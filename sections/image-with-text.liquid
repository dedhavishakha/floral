{%- liquid
  assign s = section.settings
  assign image_sizes = '(min-width: 750px) ' | append: s.image_width | append: 'vw, 100vw'
-%}
<div
  class="section image-with-text color-{{ s.color_scheme }}"
  style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px;"
>
  <div class="page-width{% if s.full_width %} page-width--full page-width--flush{% endif %}">
    <div
      class="iwt iwt--image-{{ s.image_position }} iwt--valign-{{ s.vertical_alignment }}{% if s.image_2 != blank %} iwt--has-accent{% endif %}"
      style="--iwt-image: {{ s.image_width }}%;"
    >
      <div class="iwt__media-wrap reveal">
        <div class="iwt__media media media--{{ s.image_ratio }} media--size-{{ s.image_size }}" style="--ratio: {{ s.image.aspect_ratio | default: 0.8 }};">
          {%- if s.image != blank -%}
            {%- assign iwt_alt = s.image.alt | escape -%}
            {{ s.image | image_url: width: 2000 | image_tag: widths: '400, 600, 800, 1000, 1400, 2000', sizes: image_sizes, loading: 'lazy', alt: iwt_alt }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        {%- if s.image_2 != blank -%}
          <div class="iwt__accent media media--portrait">
            {%- assign accent_alt = s.image_2.alt | escape -%}
            {{ s.image_2 | image_url: width: 900 | image_tag: widths: '300, 450, 600, 900', sizes: '(min-width: 750px) 20vw, 40vw', loading: 'lazy', alt: accent_alt }}
          </div>
        {%- endif -%}
      </div>

      <div class="iwt__content iwt__align-{{ s.text_alignment }} reveal" style="--reveal-index: 1;">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          {%- case block.type -%}
            {%- when 'eyebrow' -%}
              <p class="eyebrow" {{ block.shopify_attributes }}>{{ b.text | escape }}</p>
            {%- when 'heading' -%}
              <h2 class="iwt__heading {{ b.size }}" {{ block.shopify_attributes }}>{{ b.heading }}</h2>
            {%- when 'text' -%}
              <div class="iwt__text rte{% if b.style == 'large' %} text-large{% elsif b.style == 'muted' %} text-muted{% endif %}" {{ block.shopify_attributes }}>{{ b.text }}</div>
            {%- when 'button' -%}
              {%- if b.label != blank -%}
                <div class="iwt__button" {{ block.shopify_attributes }}>
                  <a
                    {% if b.link != blank %}href="{{ b.link }}"{% else %}role="link" aria-disabled="true"{% endif %}
                    class="{% if b.style == 'secondary' %}button button--secondary{% elsif b.style == 'link' %}link{% else %}button{% endif %}"
                  >
                    {{- b.label | escape -}}
                  </a>
                </div>
              {%- endif -%}
            {%- when 'fact' -%}
              <div class="iwt__fact" {{ block.shopify_attributes }}>
                <span class="iwt__fact-label">{{ b.label | escape }}</span>
                <span class="iwt__fact-value">{{ b.value }}</span>
              </div>
            {%- when '@app' -%}
              {% render block %}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image with text",
  "tag": "section",
  "class": "section-image-with-text",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Shown in the shape set by Image ratio. Recommended: 3:4 portrait, 1200 x 1600 px." },
    { "type": "image_picker", "id": "image_2", "label": "Overlapping image", "info": "Optional small image that overlaps the main image. Recommended: 3:4 portrait, 600 x 800 px." },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "range", "id": "image_width", "label": "Image width", "min": 35, "max": 65, "step": 5, "unit": "%", "default": 50 },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "portrait", "label": "Portrait 3:4" },
        { "value": "tall", "label": "Tall 2:3" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape 4:3" },
        { "value": "natural", "label": "Original image ratio" }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "image_size",
      "label": "Image size",
      "options": [
        { "value": "original", "label": "Original image ratio" },
        { "value": "ratio", "label": "Use image ratio" },
        { "value": "x-small", "label": "X-Small" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "ratio",
      "info": "Original image ratio shows each image uncropped in its own shape. X-Small to Large show every image at the same height and crop to fit. Use image ratio keeps the shape chosen above."
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Content vertical alignment",
      "options": [
        { "value": "start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "start"
    },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "limit": 1,
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Our story" }]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 2,
      "settings": [
        { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Made slowly, worn for years" },
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "options": [
            { "value": "h1", "label": "Extra large" },
            { "value": "h2", "label": "Large" },
            { "value": "h3", "label": "Medium" }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every piece starts as a sketch in our studio and is cut from natural fibres by workshops we have known for years.</p>" },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "body", "label": "Body" },
            { "value": "large", "label": "Large" },
            { "value": "muted", "label": "Muted" }
          ],
          "default": "body"
        }
      ]
    },
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Fabrics" },
        { "type": "inline_richtext", "id": "value", "label": "Value", "default": "Organic cotton, linen and responsibly sourced wool" }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Read our story" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "primary", "label": "Solid" },
            { "value": "secondary", "label": "Outline" },
            { "value": "link", "label": "Text link" }
          ],
          "default": "secondary"
        }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Image with text",
      "blocks": [
        { "type": "eyebrow" },
        { "type": "heading" },
        { "type": "text" },
        { "type": "button" }
      ]
    },
    {
      "name": "Brand story",
      "settings": { "image_width": 55 },
      "blocks": [
        { "type": "eyebrow" },
        { "type": "heading" },
        { "type": "text" },
        { "type": "fact", "settings": { "label": "Fabrics", "value": "Organic cotton, linen and responsibly sourced wool" } },
        { "type": "fact", "settings": { "label": "Made in", "value": "Family-run workshops in Portugal and India" } },
        { "type": "fact", "settings": { "label": "Repairs", "value": "Free alterations and repairs for two years" } },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
