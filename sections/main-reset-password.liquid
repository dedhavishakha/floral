<div
  class="section customer customer--reset color-{{ section.settings.color_scheme }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width page-width--narrow">
    <div class="customer__panel">
      <header class="section-header section-header--center">
        <div class="section-header__text">
          <h1 class="h1">{{ 'customer.reset_password.title' | t }}</h1>
          <p class="text-muted">{{ 'customer.reset_password.subtext' | t }}</p>
        </div>
      </header>
      {%- form 'reset_customer_password', class: 'customer__form' -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="field">
          <label class="field__label" for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
          <input class="field__input" type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" required>
        </div>
        <div class="field">
          <label class="field__label" for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
          <input class="field__input" type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" required>
        </div>
        <button type="submit" class="button button--full">{{ 'customer.reset_password.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Reset password",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ]
}
{% endschema %}
