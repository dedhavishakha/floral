{%- liquid
  assign cols_desktop = section.settings.columns_desktop
  assign cols_tablet = cols_desktop | at_most: 3
  assign cols_mobile = section.settings.columns_mobile
  if cols_desktop > 4
    assign card_sizes = '(min-width: 990px) 20vw, (min-width: 750px) 30vw, 50vw'
  else
    assign card_sizes = '(min-width: 990px) 25vw, (min-width: 750px) 30vw, 50vw'
  endif
-%}
<product-recommendations
  class="section product-recommendations color-{{ section.settings.color_scheme }}{% unless section.settings.image_zoom %} zoom-off{% endunless %}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent=related"
  data-recommendations-id="{{ section.id }}"
>
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <div class="page-width" data-recommendations-content>
      <carousel-slider class="carousel carousel--peek-{{ section.settings.carousel_peek }}">
        {%- if section.settings.heading != blank or section.settings.layout == 'carousel' -%}
          <div class="section-header{% if section.settings.heading_alignment == 'center' %} section-header--center{% endif %}">
            <div class="section-header__text">
              {%- if section.settings.heading != blank -%}
                <h2 class="h2">{{ section.settings.heading | escape }}</h2>
              {%- endif -%}
            </div>
            {%- if section.settings.layout == 'carousel' -%}
              <div class="section-header__actions">
                <div class="carousel__nav">
                  <button type="button" class="icon-button icon-button--bordered" data-carousel-prev aria-label="{{ 'general.accessibility.previous_slide' | t }}">
                    {%- render 'icon', icon: 'chevron-left' -%}
                  </button>
                  <button type="button" class="icon-button icon-button--bordered" data-carousel-next aria-label="{{ 'general.accessibility.next_slide' | t }}">
                    {%- render 'icon', icon: 'chevron-right' -%}
                  </button>
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
        <ul
          class="{% if section.settings.layout == 'carousel' %}carousel__track{% else %}grid{% endif %}"
          {% if section.settings.layout == 'carousel' %}data-carousel-track{% endif %}
          role="list"
          style="--cols-desktop: {{ cols_desktop }}; --cols-tablet: {{ cols_tablet }}; --cols-mobile: {{ cols_mobile }};"
        >
          {%- for recommendation in recommendations.products -%}
            <li class="reveal" style="--reveal-index: {{ forloop.index0 | at_most: 6 }};">
              {% render 'product-card',
                product: recommendation,
                card_style: section.settings.card_style,
                image_ratio: section.settings.image_ratio,
                sizes: card_sizes,
                section_id: section.id
              %}
            </li>
          {%- endfor -%}
        </ul>
        {%- if section.settings.layout == 'carousel' -%}
          {%- if section.settings.show_progress -%}<div class="carousel__progress" aria-hidden="true"><span class="carousel__progress-bar"></span></div>{%- endif -%}
        {%- endif -%}
      </carousel-slider>
    </div>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "Product recommendations",
  "tag": "section",
  "class": "section-product-recommendations",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "paragraph", "content": "Recommendations update automatically from order and product data. Fine-tune them with the Shopify Search & Discovery app." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "start"
    },
    { "type": "range", "id": "products_to_show", "label": "Maximum products", "min": 2, "max": 10, "step": 1, "default": 8 },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "carousel", "label": "Carousel" },
        { "value": "grid", "label": "Grid" }
      ],
      "default": "carousel"
    },
    { "type": "range", "id": "columns_desktop", "label": "Desktop columns", "min": 2, "max": 5, "step": 1, "default": 4 },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    { "type": "checkbox", "id": "carousel_peek", "label": "Show part of the next item", "info": "Carousel only.", "default": true },
    { "type": "checkbox", "id": "show_progress", "label": "Show progress bar", "info": "Carousel only.", "default": true },
    { "type": "header", "content": "Product cards" },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card layout",
      "options": [
        { "value": "inherit", "label": "Use theme setting" },
        { "value": "minimal", "label": "Minimal" },
        { "value": "standard", "label": "Fashion standard" },
        { "value": "conversion", "label": "Conversion" },
        { "value": "editorial", "label": "Editorial" }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "inherit", "label": "Use theme setting" },
        { "value": "portrait", "label": "Portrait 3:4" },
        { "value": "portrait-45", "label": "Portrait 4:5" },
        { "value": "tall", "label": "Tall 2:3" },
        { "value": "square", "label": "Square 1:1" },
        { "value": "natural", "label": "Natural" }
      ],
      "default": "inherit"
    },
    { "type": "checkbox", "id": "image_zoom", "label": "Zoom images on hover", "info": "Works when Theme settings > Animations > Image hover effect uses zoom.", "default": true },
    { "type": "header", "content": "Section" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [
    { "name": "Product recommendations" }
  ]
}
{% endschema %}
