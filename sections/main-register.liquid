<div
  class="section customer customer--register color-{{ section.settings.color_scheme }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width page-width--narrow">
    <div class="customer__panel">
      <header class="section-header section-header--center">
        <div class="section-header__text">
          <h1 class="h1">{{ 'customer.register.title' | t }}</h1>
        </div>
      </header>
      {%- form 'create_customer', novalidate: 'novalidate', class: 'customer__form' -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert" tabindex="-1" autofocus>
            <p>{{ 'customer.register.error_heading' | t }}</p>
            <ul>
              {%- for field in form.errors -%}
                <li>
                  {%- if field == 'form' -%}
                    {{ form.errors.messages[field] }}
                  {%- else -%}
                    <a href="#Register-{{ field }}" class="link">{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
        <div class="customer__row">
          <div class="field">
            <label class="field__label" for="Register-first_name">{{ 'customer.register.first_name' | t }}</label>
            <input class="field__input" type="text" id="Register-first_name" name="customer[first_name]" value="{{ form.first_name }}" autocomplete="given-name">
          </div>
          <div class="field">
            <label class="field__label" for="Register-last_name">{{ 'customer.register.last_name' | t }}</label>
            <input class="field__input" type="text" id="Register-last_name" name="customer[last_name]" value="{{ form.last_name }}" autocomplete="family-name">
          </div>
        </div>
        <div class="field">
          <label class="field__label" for="Register-email">{{ 'customer.register.email' | t }}</label>
          <input
            class="field__input"
            type="email"
            id="Register-email"
            name="customer[email]"
            value="{{ form.email }}"
            autocomplete="email"
            autocapitalize="off"
            spellcheck="false"
            required
            {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
          >
        </div>
        <div class="field">
          <label class="field__label" for="Register-password">{{ 'customer.register.password' | t }}</label>
          <input
            class="field__input"
            type="password"
            id="Register-password"
            name="customer[password]"
            autocomplete="new-password"
            required
            {% if form.errors contains 'password' %}aria-invalid="true"{% endif %}
          >
        </div>
        <label class="checkbox customer__marketing" for="Register-marketing">
          <input type="checkbox" id="Register-marketing" name="customer[accepts_marketing]" value="true">
          <span>{{ 'customer.register.marketing' | t }}</span>
        </label>
        <button type="submit" class="button button--full">{{ 'customer.register.submit' | t }}</button>
        <p class="customer__alt">
          {{ 'customer.register.have_account' | t }}
          <a href="{{ routes.account_login_url }}" class="link">{{ 'customer.login_page.sign_in' | t }}</a>
        </p>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer register",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ]
}
{% endschema %}
