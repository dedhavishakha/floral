{%- assign s = section.settings -%}
<div
  class="section logo-list color-{{ s.color_scheme }}"
  style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px; --logo-height: {{ s.logo_height }}px;"
>
  <div class="page-width">
    {%- if s.heading != blank -%}
      <div class="section-header section-header--center">
        <div class="section-header__text">
          <h2 class="h2 logo-list__heading">{{ s.heading }}</h2>
        </div>
      </div>
    {%- endif -%}
    <ul class="logo-list__items{% if s.grayscale %} logo-list__items--mono{% endif %}" role="list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="logo-list__item reveal" style="--reveal-index: {{ forloop.index0 | modulo: 6 }};" {{ block.shopify_attributes }}>
          {%- capture logo_markup -%}
            {%- if b.image != blank -%}
              {%- assign logo_alt = b.image.alt | default: b.name | escape -%}
              {{ b.image | image_url: width: 480 | image_tag: widths: '160, 240, 320, 480', sizes: '160px', loading: 'lazy', alt: logo_alt, class: 'logo-list__image' }}
            {%- else -%}
              {{ 'logo' | placeholder_svg_tag: 'logo-list__placeholder' }}
              <span class="visually-hidden">{{ b.name | escape }}</span>
            {%- endif -%}
          {%- endcapture -%}
          {%- if b.link != blank -%}
            <a href="{{ b.link }}" class="logo-list__link">{{ logo_markup }}</a>
          {%- else -%}
            {{ logo_markup }}
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Logo list",
  "tag": "section",
  "class": "section-logo-list",
  "max_blocks": 12,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "As featured in" },
    { "type": "range", "id": "logo_height", "label": "Logo height", "min": 20, "max": 80, "step": 2, "unit": "px", "default": 32 },
    { "type": "checkbox", "id": "grayscale", "label": "Show logos in one color", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo image", "info": "Recommended: transparent PNG or SVG, about 2:1 (400 x 200 px)." },
        { "type": "text", "id": "name", "label": "Brand name", "info": "Shown when no image is set and used as alt text.", "default": "Partner" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo list",
      "blocks": [
        { "type": "logo", "settings": { "name": "Partner" } },
        { "type": "logo", "settings": { "name": "Partner" } },
        { "type": "logo", "settings": { "name": "Partner" } },
        { "type": "logo", "settings": { "name": "Partner" } },
        { "type": "logo", "settings": { "name": "Partner" } }
      ]
    }
  ]
}
{% endschema %}
