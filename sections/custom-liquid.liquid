{%- assign s = section.settings -%}
<div
  class="section custom-liquid color-{{ s.color_scheme }}"
  style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px;"
>
  <div class="{% if s.full_width %}page-width page-width--full page-width--flush{% else %}page-width{% endif %}">
    {{ s.custom_liquid }}
  </div>
</div>

{% schema %}
{
  "name": "Custom Liquid",
  "tag": "section",
  "class": "section-custom-liquid",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Liquid code",
      "info": "Add app snippets or other Liquid code to create advanced customizations."
    },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [{ "name": "Custom Liquid" }]
}
{% endschema %}
