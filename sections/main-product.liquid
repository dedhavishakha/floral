{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign buy_blocks = section.blocks | where: 'type', 'buy_buttons'
  assign show_sticky = false
  if section.settings.sticky_atc and buy_blocks.size > 0 and product != blank
    assign show_sticky = true
  endif
  assign form_id = 'product-form-' | append: section.id
  assign quantity_blocks = section.blocks | where: 'type', 'quantity'
  assign has_quantity_block = false
  if quantity_blocks.size > 0
    assign has_quantity_block = true
  endif
  assign sticky_media = variant.featured_media | default: product.featured_media
  assign accordion_open = false
  assign vendor_html = ''
-%}
<div
  class="section main-product color-{{ section.settings.color_scheme }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <product-page
      class="product product--{{ section.settings.media_size }} product--gallery-{{ section.settings.gallery_layout }}{% if section.settings.sticky_info %} product--sticky-info{% endif %}"
      data-fit-screen="{{ section.settings.fit_media_to_screen }}"
      data-product-root
      data-section-id="{{ section.id }}"
      data-product-handle="{{ product.handle }}"
    >
      <div class="product__media">
        {% render 'product-gallery',
          product: product,
          section_id: section.id,
          layout: section.settings.gallery_layout,
          media_size: section.settings.media_size,
          lightbox: section.settings.enable_lightbox,
          hover_zoom: section.settings.enable_hover_zoom,
          group_by_color: section.settings.group_media_by_color
        %}
      </div>

      <div class="product__info">
        <div class="product__info-inner">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                <div class="product__block product__block--app">{% render block %}</div>

              {%- when 'vendor' -%}
                {%- if product.vendor != blank -%}
                  {%- capture vendor_html -%}
                    <p class="product__vendor eyebrow" {{ block.shopify_attributes }}>
                      <span class="visually-hidden">{{ 'products.product.vendor' | t }}</span>
                      {%- if block.settings.link_to_vendor -%}
                        <a href="{{ product.vendor | url_for_vendor }}" class="product__vendor-link">{{ product.vendor | escape }}</a>
                      {%- else -%}
                        {{ product.vendor | escape }}
                      {%- endif -%}
                    </p>
                  {%- endcapture -%}
                  {%- assign next_block = section.blocks[forloop.index] -%}
                  {%- if next_block.type != 'title' -%}
                    {{- vendor_html -}}
                    {%- assign vendor_html = '' -%}
                  {%- endif -%}
                {%- endif -%}

              {%- when 'title' -%}
                {%- capture title_html -%}
                  <h1 class="product__title {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
                    {{- product.title | escape -}}
                  </h1>
                {%- endcapture -%}
                {%- if vendor_html != blank -%}
                  <div class="product__heading">
                    {{- vendor_html -}}
                    {{- title_html -}}
                  </div>
                  {%- assign vendor_html = '' -%}
                {%- else -%}
                  {{- title_html -}}
                {%- endif -%}

              {%- when 'price' -%}
                <div class="product__price" {{ block.shopify_attributes }}>
                  <div data-update="price">
                    {% render 'price', product: product, use_variant: true, class: 'price--large' %}
                  </div>
                  {%- if block.settings.show_tax_note -%}
                    {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                      <p class="product__tax">
                        {%- if cart.taxes_included -%}
                          {{ 'products.product.include_taxes' | t }}
                        {%- endif -%}
                        {%- if shop.shipping_policy.body != blank %}
                          {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                        {%- endif -%}
                      </p>
                    {%- endif -%}
                  {%- endif -%}
                </div>

              {%- when 'rating' -%}
                {%- if product.metafields.reviews.rating.value != blank -%}
                  <div class="product__rating" {{ block.shopify_attributes }}>
                    {% render 'rating', product: product, show_count: true %}
                  </div>
                {%- endif -%}

              {%- when 'badges' -%}
                <div class="product__badges" {{ block.shopify_attributes }}>
                  <div data-update="badges">
                    {% render 'badges', product: product, use_variant: true %}
                  </div>
                </div>

              {%- when 'sku' -%}
                <div class="product__sku-block" {{ block.shopify_attributes }}>
                  <p class="product__sku" data-update="sku" {% if variant.sku == blank %}hidden{% endif %}>
                    {{ 'products.product.sku' | t }}
                    <span>{{ variant.sku | escape }}</span>
                  </p>
                </div>

              {%- when 'inventory' -%}
                {%- liquid
                  assign threshold = block.settings.low_stock_threshold
                  assign tracked = false
                  if variant.inventory_management == 'shopify'
                    assign tracked = true
                  endif
                  assign stock_state = 'in-stock'
                  if variant.available == false
                    assign stock_state = 'out-of-stock'
                  elsif tracked and variant.inventory_quantity <= 0 and variant.inventory_policy == 'continue'
                    assign stock_state = 'backorder'
                  elsif tracked and variant.inventory_quantity <= threshold and threshold > 0
                    assign stock_state = 'low-stock'
                  endif
                -%}
                <div class="product__inventory-block" {{ block.shopify_attributes }}>
                  <p class="product__inventory product__inventory--{{ stock_state }}" data-update="inventory">
                    <span class="product__inventory-dot" aria-hidden="true"></span>
                    {%- case stock_state -%}
                      {%- when 'out-of-stock' -%}
                        {{ 'products.inventory.out_of_stock' | t }}
                      {%- when 'backorder' -%}
                        {{ 'products.inventory.backorder' | t }}
                      {%- when 'low-stock' -%}
                        {%- if block.settings.show_count -%}
                          {{ 'products.inventory.low_stock_count' | t: count: variant.inventory_quantity }}
                        {%- else -%}
                          {{ 'products.inventory.low_stock' | t }}
                        {%- endif -%}
                      {%- else -%}
                        {{ 'products.inventory.in_stock' | t }}
                    {%- endcase -%}
                  </p>
                </div>

              {%- when 'variant_picker' -%}
                {%- unless product.has_only_default_variant -%}
                  <div class="product__block product__block--picker" {{ block.shopify_attributes }}>
                    {% render 'variant-picker',
                      product: product,
                      section_id: section.id,
                      update_url: true,
                      picker_style: block.settings.picker_style,
                      show_swatches: block.settings.show_swatches,
                      size_guide_page: block.settings.size_guide_page
                    %}
                  </div>
                {%- endunless -%}

              {%- when 'size_guide' -%}
                {%- if block.settings.page != blank -%}
                  <div class="product__size-guide" {{ block.shopify_attributes }}>
                    <button type="button" class="link" data-modal-template="SizeGuideBlock-{{ block.id }}" aria-haspopup="dialog">
                      {%- render 'icon', icon: 'ruler' -%}
                      {%- if block.settings.label != blank -%}
                        {{- block.settings.label | escape -}}
                      {%- else -%}
                        {{- 'products.product.size_guide' | t -}}
                      {%- endif -%}
                    </button>
                    <template id="SizeGuideBlock-{{ block.id }}">
                      <h2 id="PageModalTitle" class="h3">{{ block.settings.page.title | escape }}</h2>
                      {{ block.settings.page.content }}
                    </template>
                  </div>
                {%- endif -%}

              {%- when 'quantity' -%}
                {%- liquid
                  assign qty_variant = product.selected_or_first_available_variant
                  assign qty_id = 'Quantity-block-' | append: section.id
                -%}
                <div class="product__block product__block--quantity" {{ block.shopify_attributes }}>
                  <label class="product__quantity-label" for="{{ qty_id }}">{{ 'products.product.quantity.label' | t }}</label>
                  <quantity-input class="quantity">
                    <button type="button" class="quantity__button" name="minus" aria-label="{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}">
                      {%- render 'icon', icon: 'minus' -%}
                    </button>
                    <input
                      class="quantity__input"
                      type="number"
                      name="quantity"
                      id="{{ qty_id }}"
                      value="{{ qty_variant.quantity_rule.min | default: 1 }}"
                      min="{{ qty_variant.quantity_rule.min | default: 1 }}"
                      step="{{ qty_variant.quantity_rule.increment | default: 1 }}"
                      {% if qty_variant.quantity_rule.max != null %}max="{{ qty_variant.quantity_rule.max }}"{% endif %}
                      form="{{ form_id }}"
                      inputmode="numeric"
                    >
                    <button type="button" class="quantity__button" name="plus" aria-label="{{ 'products.product.quantity.increase' | t: product: product.title | escape }}">
                      {%- render 'icon', icon: 'plus' -%}
                    </button>
                  </quantity-input>
                </div>

              {%- when 'buy_buttons' -%}
                <div class="product__block product__block--buy" data-main-buy-buttons {{ block.shopify_attributes }}>
                  {% render 'buy-buttons',
                    product: product,
                    section_id: section.id,
                    show_quantity: block.settings.show_quantity,
                    hide_quantity: has_quantity_block,
                    show_dynamic_checkout: block.settings.show_dynamic_checkout,
                    show_installments: block.settings.show_installments
                  %}
                  {% render 'wishlist-toggle', product: product, style: 'text', class: 'product__wishlist' %}
                </div>

              {%- when 'description' -%}
                {%- if product.description != blank -%}
                  <div class="product__description rte" {{ block.shopify_attributes }}>
                    {{ product.description }}
                  </div>
                {%- endif -%}

              {%- when 'collapsible_tab' -%}
                {%- if block.settings.content != blank or block.settings.page != blank -%}
                  {%- liquid
                    assign next_is_accordion = false
                    assign next_index = forloop.index
                    for later in section.blocks offset: next_index
                      if later.type != 'collapsible_tab'
                        break
                      endif
                      if later.settings.content != blank or later.settings.page != blank
                        assign next_is_accordion = true
                        break
                      endif
                    endfor
                  -%}
                  {%- unless accordion_open -%}
                    <div class="product-accordions">
                    {%- assign accordion_open = true -%}
                  {%- endunless -%}
                  <details class="product-accordion" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
                    <summary class="product-accordion__summary">
                      {%- if block.settings.icon != 'none' -%}
                        {%- render 'icon', icon: block.settings.icon, class: 'product-accordion__icon' -%}
                      {%- endif -%}
                      <span class="product-accordion__heading">{{ block.settings.heading | escape }}</span>
                      {%- render 'icon', icon: 'plus', class: 'product-accordion__toggle' -%}
                    </summary>
                    <div class="product-accordion__content rte">
                      {{ block.settings.content }}
                      {{ block.settings.page.content }}
                    </div>
                  </details>
                  {%- unless next_is_accordion -%}
                    </div>
                    {%- assign accordion_open = false -%}
                  {%- endunless -%}
                {%- endif -%}

              {%- when 'tabs' -%}
                <product-tabs class="product-tabs" {{ block.shopify_attributes }}>
                  <div class="product-tabs__list" role="tablist" aria-label="{{ 'products.tabs.label' | t }}">
                    {%- assign tab_index = 0 -%}
                    {%- for i in (1..3) -%}
                      {%- liquid
                        assign title_key = 'tab_' | append: i | append: '_title'
                        assign content_key = 'tab_' | append: i | append: '_content'
                        assign page_key = 'tab_' | append: i | append: '_page'
                        assign has_content = false
                        if block.settings[content_key] != blank or block.settings[page_key] != blank
                          assign has_content = true
                        endif
                        if i == 1 and block.settings.use_description and product.description != blank
                          assign has_content = true
                        endif
                      -%}
                      {%- if block.settings[title_key] != blank and has_content -%}
                        <button
                          type="button"
                          class="product-tabs__tab"
                          role="tab"
                          id="Tab-{{ block.id }}-{{ i }}"
                          aria-controls="TabPanel-{{ block.id }}-{{ i }}"
                          aria-selected="{% if tab_index == 0 %}true{% else %}false{% endif %}"
                          tabindex="{% if tab_index == 0 %}0{% else %}-1{% endif %}"
                        >
                          {{- block.settings[title_key] | escape -}}
                        </button>
                        {%- assign tab_index = tab_index | plus: 1 -%}
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                  {%- assign tab_index = 0 -%}
                  {%- for i in (1..3) -%}
                    {%- liquid
                      assign title_key = 'tab_' | append: i | append: '_title'
                      assign content_key = 'tab_' | append: i | append: '_content'
                      assign page_key = 'tab_' | append: i | append: '_page'
                      assign use_desc = false
                      if i == 1 and block.settings.use_description and product.description != blank
                        assign use_desc = true
                      endif
                      assign has_content = use_desc
                      if block.settings[content_key] != blank or block.settings[page_key] != blank
                        assign has_content = true
                      endif
                    -%}
                    {%- if block.settings[title_key] != blank and has_content -%}
                      <div
                        class="product-tabs__panel rte"
                        role="tabpanel"
                        id="TabPanel-{{ block.id }}-{{ i }}"
                        aria-labelledby="Tab-{{ block.id }}-{{ i }}"
                        tabindex="0"
                        {% if tab_index > 0 %}hidden{% endif %}
                      >
                        {%- if use_desc -%}{{ product.description }}{%- endif -%}
                        {{ block.settings[content_key] }}
                        {{ block.settings[page_key].content }}
                      </div>
                      {%- assign tab_index = tab_index | plus: 1 -%}
                    {%- endif -%}
                  {%- endfor -%}
                </product-tabs>

              {%- when 'fit_info' -%}
                {%- if block.settings.text != blank -%}
                  <div class="product__fit" {{ block.shopify_attributes }}>
                    {%- render 'icon', icon: 'ruler', class: 'product__fit-icon' -%}
                    <div class="product__fit-body">
                      {%- if block.settings.heading != blank -%}
                        <p class="product__fit-heading">{{ block.settings.heading | escape }}</p>
                      {%- endif -%}
                      <div class="product__fit-text rte">{{ block.settings.text }}</div>
                    </div>
                  </div>
                {%- endif -%}

              {%- when 'pickup_availability' -%}
                <div class="product__pickup-block" {{ block.shopify_attributes }}>
                  <pickup-availability
                    class="pickup"
                    data-update="pickup"
                    data-variant-id="{{ variant.id }}"
                    data-available="{{ variant.available }}"
                    data-root-url="{{ routes.root_url }}"
                  ></pickup-availability>
                </div>

              {%- when 'bought_together' -%}
                {%- liquid
                  assign fbt_items = block.settings.products
                  if fbt_items == empty and block.settings.use_recommendations and recommendations.performed?
                    assign fbt_items = recommendations.products
                  endif
                  assign fbt_count = fbt_items | size
                -%}
                <fbt-bundle
                  class="fbt"
                  data-block-id="{{ block.id }}"
                  data-currency="{{ cart.currency.iso_code }}"
                  {% if fbt_count == 0 and block.settings.use_recommendations %}
                    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=3&intent=complementary"
                  {% endif %}
                  {{ block.shopify_attributes }}
                >
                  {%- if fbt_count > 0 -%}
                    <div class="fbt__inner" data-fbt-content>
                      {%- if block.settings.heading != blank -%}
                        <h2 class="fbt__heading h5">{{ block.settings.heading | escape }}</h2>
                      {%- endif -%}
                      <ul class="fbt__list" role="list">
                        {%- assign current_id = 'fbt-' | append: block.id | append: '-0' -%}
                        {% render 'fbt-item', item: product, check_id: current_id, is_current: true %}
                        {%- for item in fbt_items limit: 4 -%}
                          {%- if item.id == product.id -%}{%- continue -%}{%- endif -%}
                          {%- assign item_check_id = 'fbt-' | append: block.id | append: '-' | append: forloop.index -%}
                          {% render 'fbt-item', item: item, check_id: item_check_id %}
                        {%- endfor -%}
                      </ul>
                      <div class="fbt__footer">
                        <p class="fbt__total" aria-live="polite">
                          {{ 'products.fbt.total' | t }}
                          <strong data-fbt-total></strong>
                        </p>
                        <button type="button" class="button button--secondary button--full" data-fbt-add>
                          <span>{{ 'products.fbt.add' | t }}</span>
                          <span class="loading-spinner" aria-hidden="true"></span>
                        </button>
                        <p class="product-form__error" role="alert" data-fbt-error hidden></p>
                      </div>
                    </div>
                  {%- endif -%}
                </fbt-bundle>

              {%- when 'complementary_products' -%}
                <product-recommendations
                  class="complementary"
                  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ block.settings.product_limit }}&intent=complementary"
                  data-recommendations-id="{{ block.id }}"
                  {{ block.shopify_attributes }}
                >
                  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
                    <div class="complementary__inner" data-recommendations-content>
                      {%- if block.settings.heading != blank -%}
                        <div class="section-header">
                          <div class="section-header__text">
                            <h2 class="complementary__heading h5">{{ block.settings.heading | escape }}</h2>
                          </div>
                        </div>
                      {%- endif -%}
                      <ul class="complementary__list" role="list">
                        {%- for item in recommendations.products -%}
                          <li class="complementary__item">
                            <a href="{{ item.url }}" class="complementary__media media media--{{ settings.product_image_ratio }}" style="--ratio: {{ item.featured_media.preview_image.aspect_ratio | default: 0.75 }};" tabindex="-1" aria-hidden="true">
                              {%- if item.featured_media -%}
                                {{ item.featured_media.preview_image | image_url: width: 240 | image_tag: widths: '120, 180, 240', sizes: '5rem', loading: 'lazy', alt: '' }}
                              {%- else -%}
                                {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
                              {%- endif -%}
                            </a>
                            <div class="complementary__info">
                              <a href="{{ item.url }}" class="complementary__title">{{ item.title | escape }}</a>
                              {% render 'price', product: item %}
                            </div>
                            {%- if item.available -%}
                              {%- if item.has_only_default_variant -%}
                                <product-form class="complementary__form">
                                  {%- assign complementary_form_id = 'complementary-' | append: block.id | append: '-' | append: item.id -%}
                                  {%- form 'product', item, id: complementary_form_id, novalidate: 'novalidate' -%}
                                    <input type="hidden" name="id" value="{{ item.selected_or_first_available_variant.id }}">
                                    <button type="submit" name="add" class="icon-button icon-button--bordered" aria-label="{{ 'products.card.quick_add' | t }}: {{ item.title | escape }}">
                                      {%- render 'icon', icon: 'plus' -%}
                                    </button>
                                  {%- endform -%}
                                </product-form>
                              {%- else -%}
                                <button type="button" class="icon-button icon-button--bordered" data-quick-view="{{ item.url }}" aria-haspopup="dialog" aria-label="{{ 'products.card.choose_options' | t }}: {{ item.title | escape }}">
                                  {%- render 'icon', icon: 'plus' -%}
                                </button>
                              {%- endif -%}
                            {%- endif -%}
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  {%- endif -%}
                </product-recommendations>

              {%- when 'icon_with_text' -%}
                <ul class="product__icons" role="list" {{ block.shopify_attributes }}>
                  {%- for i in (1..3) -%}
                    {%- liquid
                      assign icon_key = 'icon_' | append: i
                      assign text_key = 'text_' | append: i
                    -%}
                    {%- if block.settings[text_key] != blank -%}
                      <li class="product__icon-item">
                        {%- render 'icon', icon: block.settings[icon_key] -%}
                        <span>{{ block.settings[text_key] }}</span>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>

              {%- when 'text' -%}
                {%- if block.settings.text != blank -%}
                  <div class="product__text product__text--{{ block.settings.text_style }} rte" {{ block.shopify_attributes }}>
                    {{ block.settings.text }}
                  </div>
                {%- endif -%}

              {%- when 'ask_question' -%}
                {% render 'product-ask-question', product: product, block: block, color_scheme: section.settings.color_scheme %}

              {%- when 'custom_liquid' -%}
                {%- if block.settings.custom_liquid != blank -%}
                  <div class="product__custom-liquid" {{ block.shopify_attributes }}>
                    {{ block.settings.custom_liquid }}
                  </div>
                {%- endif -%}

              {%- when 'share' -%}
                <share-button
                  class="product__share"
                  data-url="{{ request.origin }}{{ product.url }}"
                  data-title="{{ product.title | escape }}"
                  data-copied="{{ 'products.share.copied' | t | escape }}"
                  {{ block.shopify_attributes }}
                >
                  <button type="button" class="link product__share-button" data-share>
                    {%- render 'icon', icon: 'share' -%}
                    {{- block.settings.label | escape -}}
                  </button>
                  <span class="visually-hidden" role="status" data-share-status></span>
                </share-button>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>

      {%- if show_sticky -%}
        <sticky-atc class="sticky-atc color-{{ section.settings.color_scheme }}" data-section-id="{{ section.id }}" role="region" aria-label="{{ 'products.sticky.label' | t }}" inert>
          <div class="page-width sticky-atc__inner" data-update="sticky">
            {%- if sticky_media -%}
              <div class="sticky-atc__media media media--{{ settings.product_image_ratio }}" style="--ratio: {{ sticky_media.preview_image.aspect_ratio }};">
                {{ sticky_media.preview_image | image_url: width: 160 | image_tag: widths: '80, 120, 160', sizes: '3.5rem', loading: 'lazy', alt: '' }}
              </div>
            {%- endif -%}
            <div class="sticky-atc__info">
              <p class="sticky-atc__title">{{ product.title | escape }}</p>
              {%- unless product.has_only_default_variant -%}
                <p class="sticky-atc__variant">{{ variant.title | escape }}</p>
              {%- endunless -%}
            </div>
            {% render 'price', product: product, use_variant: true, class: 'sticky-atc__price' %}
            <button
              type="submit"
              form="{{ form_id }}"
              name="add"
              class="button sticky-atc__button"
              {% if variant.available != true %}disabled{% endif %}
            >
              {%- if variant == blank -%}
                {{- 'products.product.unavailable' | t -}}
              {%- elsif variant.available -%}
                {{- 'products.product.add_to_cart' | t -}}
              {%- else -%}
                {{- 'products.product.sold_out' | t -}}
              {%- endif -%}
            </button>
          </div>
        </sticky-atc>
      {%- endif -%}
    </product-page>
  </div>

  {%- if product != blank -%}
    <script type="application/ld+json">
      {{ product | structured_data }}
    </script>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "class": "section-main-product",
  "blocks": [
    { "type": "@app" },
    {
      "type": "vendor",
      "name": "Vendor",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "link_to_vendor", "label": "Link to vendor collection", "default": false }
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            { "value": "h1", "label": "Large" },
            { "value": "h2", "label": "Medium" },
            { "value": "h3", "label": "Small" }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_tax_note", "label": "Show tax and shipping note", "default": true }
