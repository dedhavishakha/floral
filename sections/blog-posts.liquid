{%- liquid
  assign s = section.settings
  assign cols_tablet = s.columns_desktop | at_most: 2
  assign post_vw = 100 | divided_by: s.columns_desktop
  assign post_sizes = '(min-width: 990px) ' | append: post_vw | append: 'vw, (min-width: 750px) 50vw, 85vw'
-%}
<div
  class="section blog-posts color-{{ s.color_scheme }}{% unless s.image_zoom %} zoom-off{% endunless %}"
  style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px;"
>
  <carousel-slider class="page-width carousel carousel--peek-{{ s.carousel_peek }}">
    <div class="section-header">
      <div class="section-header__text">
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading }}</h2>{%- endif -%}
      </div>
      <div class="section-header__actions">
        {%- if s.blog != blank and s.view_all_label != blank -%}
          <a href="{{ s.blog.url }}" class="link">{{ s.view_all_label | escape }}</a>
        {%- endif -%}
        {%- if s.layout == 'carousel' -%}
          <div class="carousel__nav">
            <button type="button" class="icon-button icon-button--bordered" data-carousel-prev aria-label="{{ 'general.accessibility.previous_slide' | t }}">
              {%- render 'icon', icon: 'chevron-left' -%}
            </button>
            <button type="button" class="icon-button icon-button--bordered" data-carousel-next aria-label="{{ 'general.accessibility.next_slide' | t }}">
              {%- render 'icon', icon: 'chevron-right' -%}
            </button>
          </div>
        {%- endif -%}
      </div>
    </div>

    <ul
      class="{% if s.layout == 'carousel' %}carousel__track{% else %}grid{% endif %} blog-posts__list"
      {% if s.layout == 'carousel' %}data-carousel-track{% endif %}
      role="list"
      style="--cols-desktop: {{ s.columns_desktop }}; --cols-tablet: {{ cols_tablet }}; --cols-mobile: 1;"
    >
      {%- if s.blog != blank and s.blog.articles_count > 0 -%}
        {%- for article in s.blog.articles limit: s.post_count -%}
          <li class="article-card reveal" style="--reveal-index: {{ forloop.index0 | modulo: 4 }};">
            <div class="article-card__media media media--{{ s.image_ratio }} media--size-{{ s.image_size }}" style="--ratio: {{ article.image.aspect_ratio | default: 1.5 }};">
              {%- if article.image -%}
                {%- assign article_alt = article.image.alt | escape -%}
                {{ article.image | image_url: width: 1400 | image_tag: widths: '400, 600, 800, 1000, 1400', sizes: post_sizes, loading: 'lazy', alt: article_alt }}
              {%- else -%}
                {%- assign placeholder_number = forloop.index | modulo: 3 | plus: 1 -%}
                {%- assign placeholder_name = 'blog-apparel-' | append: placeholder_number -%}
                {{ placeholder_name | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="article-card__info">
              {%- if s.show_date or s.show_author -%}
                <p class="article-card__meta">
                  {%- if s.show_date -%}{{ article.published_at | time_tag: format: 'date' }}{%- endif -%}
                  {%- if s.show_date and s.show_author %} · {% endif -%}
                  {%- if s.show_author -%}{{ 'sections.blog_posts.by_author' | t: author: article.author }}{%- endif -%}
                </p>
              {%- endif -%}
              <h3 class="article-card__title h4"><a href="{{ article.url }}" class="article-card__link">{{ article.title | escape }}</a></h3>
              {%- if s.show_excerpt -%}
                <p class="article-card__excerpt">
                  {%- if article.excerpt.size > 0 -%}
                    {{ article.excerpt | strip_html | truncatewords: 24 }}
                  {%- else -%}
                    {{ article.content | strip_html | truncatewords: 24 }}
                  {%- endif -%}
                </p>
              {%- endif -%}
              <span class="article-card__more link" aria-hidden="true">{{ 'sections.blog_posts.read_more' | t }}</span>
            </div>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <li class="article-card">
            <div class="article-card__media media media--{{ s.image_ratio }} media--size-{{ s.image_size }}">
              {%- assign placeholder_name = 'blog-apparel-' | append: i -%}
              {{ placeholder_name | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="article-card__info">
              <h3 class="article-card__title h4">{{ 'sections.blog_posts.placeholder_title' | t }}</h3>
              <p class="article-card__excerpt">{{ 'sections.blog_posts.placeholder_excerpt' | t }}</p>
            </div>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
    {%- if s.show_progress and s.layout == 'carousel' -%}
      <div class="carousel__progress" aria-hidden="true"><span class="carousel__progress-bar"></span></div>
    {%- endif -%}
  </carousel-slider>
</div>

{% schema %}
{
  "name": "Blog posts",
  "tag": "section",
  "class": "section-blog-posts",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "post_count", "label": "Number of posts", "min": 2, "max": 9, "step": 1, "default": 3 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Journal" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Notes on style" },
    { "type": "text", "id": "view_all_label", "label": "\"View all\" label", "default": "All stories" },
    {
      "type": "select",
      "id": "layout",
      "label": "Display as",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel" }
      ],
      "default": "grid"
    },
    { "type": "range", "id": "columns_desktop", "label": "Desktop columns", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "carousel_peek", "label": "Show part of the next item", "info": "Carousel only.", "default": true },
    { "type": "checkbox", "id": "show_progress", "label": "Show progress bar", "info": "Carousel only.", "default": false },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "landscape", "label": "Landscape 4:3" },
        { "value": "portrait", "label": "Portrait 3:4" },
        { "value": "square", "label": "Square" },
        { "value": "wide", "label": "Wide 16:9" }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "image_size",
      "label": "Image size",
      "options": [
        { "value": "original", "label": "Original image ratio" },
        { "value": "ratio", "label": "Use image ratio" },
        { "value": "x-small", "label": "X-Small" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "ratio",
      "info": "Original image ratio shows each image uncropped in its own shape. X-Small to Large show every image at the same height and crop to fit. Use image ratio keeps the shape chosen above."
    },
    { "type": "checkbox", "id": "image_zoom", "label": "Zoom images on hover", "info": "Works when Theme settings > Animations > Image hover effect uses zoom.", "default": true },
    { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
    { "type": "checkbox", "id": "show_author", "label": "Show author", "default": false },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [{ "name": "Blog posts" }]
}
{% endschema %}
