{%- liquid
  assign s = section.settings
  assign form_id = 'Newsletter-' | append: section.id
  assign button_text = s.button_label
  if button_text == blank
    assign button_text = 'newsletter.button' | t
  endif
  assign has_image = false
  if s.image != blank and s.layout == 'split'
    assign has_image = true
  endif
-%}
<div
  class="section newsletter color-{{ s.color_scheme }}"
  style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="newsletter__inner newsletter__inner--{{ s.layout }}{% if has_image %} newsletter__inner--image-{{ s.image_position }}{% endif %}">
      {%- if has_image -%}
        <div class="newsletter__media media media--landscape media--size-{{ s.image_size }}" style="--ratio: {{ s.image.aspect_ratio | default: 1.3333 }};">
          {%- assign newsletter_alt = s.image.alt | escape -%}
          {{ s.image | image_url: width: 1600 | image_tag: widths: '400, 600, 800, 1100, 1600', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy', alt: newsletter_alt }}
        </div>
      {%- endif -%}
      <div class="newsletter__content reveal">
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="newsletter__heading h2">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="newsletter__text rte">{{ s.text }}</div>{%- endif -%}

        {%- form 'customer', id: form_id, class: 'newsletter__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="newsletter__field">
            <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
            <input
              id="NewsletterEmail-{{ section.id }}"
              class="field__input newsletter__input"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="{{ 'newsletter.placeholder' | t }}"
              autocomplete="email"
              autocapitalize="off"
              autocorrect="off"
              required
              {% if form.errors %}aria-invalid="true" aria-describedby="NewsletterError-{{ section.id }}"{% elsif form.posted_successfully? %}aria-describedby="NewsletterSuccess-{{ section.id }}"{% endif %}
            >
            <button type="submit" class="button newsletter__button" name="commit">
              {{- button_text | escape -}}
            </button>
          </div>
          {%- if form.errors -%}
            <p class="form-message form-message--error" id="NewsletterError-{{ section.id }}" role="alert">
              {%- render 'icon', icon: 'info' -%}
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </p>
          {%- elsif form.posted_successfully? -%}
            <p class="form-message newsletter__success" id="NewsletterSuccess-{{ section.id }}" role="status" tabindex="-1" data-newsletter-success>
              {%- render 'icon', icon: 'check' -%}
              {{ 'newsletter.success' | t }}
            </p>
          {%- endif -%}
        {%- endform -%}

        {%- if s.disclaimer != blank -%}
          <div class="newsletter__disclaimer rte text-small text-muted">{{ s.disclaimer }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "section-newsletter",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-4" },
    {
      "type": "paragraph",
      "content": "Subscribers are added to your Shopify customer list with marketing consent. Connect an email app to send campaigns."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "centered", "label": "Centered" },
        { "value": "split", "label": "Image and text" }
      ],
      "default": "centered"
    },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Used by the image and text layout. Recommended: 4:3 landscape, 1600 x 1200 px." },
    {
      "type": "select",
      "id": "image_size",
      "label": "Image size",
      "options": [
        { "value": "original", "label": "Original image ratio" },
        { "value": "ratio", "label": "Default (4:3)" },
        { "value": "x-small", "label": "X-Small" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "ratio",
      "info": "Image and text layout. Original image ratio shows the image uncropped in its own shape. X-Small to Large set a fixed image height and crop to fit."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Newsletter" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "First look at new drops" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Join for early access to new collections, private sales and styling notes. 10% off your first order.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "richtext", "id": "disclaimer", "label": "Disclaimer", "default": "<p>By subscribing you agree to receive marketing emails. Unsubscribe at any time.</p>" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
