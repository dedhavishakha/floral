{%- liquid
  assign recover_success = false
-%}
<div
  class="section customer customer--login color-{{ section.settings.color_scheme }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width page-width--narrow">
    {%- form 'recover_customer_password' -%}
      {%- assign recover_success = form.posted_successfully? -%}
    {%- endform -%}

    <div id="recover" class="customer__panel customer__panel--recover" tabindex="-1">
      <header class="section-header section-header--center">
        <div class="section-header__text">
          <h1 class="h1">{{ 'customer.recover_password.title' | t }}</h1>
          <p class="text-muted">{{ 'customer.recover_password.subtext' | t }}</p>
        </div>
      </header>
      {%- form 'recover_customer_password', class: 'customer__form' -%}
        {%- if form.errors -%}
          <p class="form-message form-message--error" role="alert">{{ form.errors.messages.form }}</p>
        {%- endif -%}
        <div class="field">
          <label class="field__label" for="RecoverEmail">{{ 'customer.login_page.email' | t }}</label>
          <input
            class="field__input"
            type="email"
            id="RecoverEmail"
            name="email"
            autocomplete="email"
            autocapitalize="off"
            spellcheck="false"
            required
            {% if form.errors %}aria-invalid="true"{% endif %}
          >
        </div>
        <button type="submit" class="button button--full">{{ 'customer.recover_password.submit' | t }}</button>
        <a href="#login" class="link customer__switch">{{ 'customer.recover_password.cancel' | t }}</a>
      {%- endform -%}
    </div>

    <div id="login" class="customer__panel customer__panel--login" tabindex="-1">
      <header class="section-header section-header--center">
        <div class="section-header__text">
          <h1 class="h1">{{ 'customer.login_page.title' | t }}</h1>
        </div>
      </header>
      {%- form 'customer_login', novalidate: 'novalidate', class: 'customer__form' -%}
        {%- if recover_success -%}
          <p class="form-message" role="status" tabindex="-1" autofocus>
            {%- render 'icon', icon: 'check' -%}
            {{ 'customer.recover_password.success' | t }}
          </p>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="field">
          <label class="field__label" for="CustomerEmail">{{ 'customer.login_page.email' | t }}</label>
          <input
            class="field__input"
            type="email"
            id="CustomerEmail"
            name="customer[email]"
            autocomplete="email"
            autocapitalize="off"
            spellcheck="false"
            required
            {% if form.errors contains 'form' %}aria-invalid="true"{% endif %}
          >
        </div>
        {%- if form.password_needed -%}
          <div class="field">
            <label class="field__label" for="CustomerPassword">{{ 'customer.login_page.password' | t }}</label>
            <input
              class="field__input"
              type="password"
              id="CustomerPassword"
              name="customer[password]"
              autocomplete="current-password"
              required
              {% if form.errors contains 'form' %}aria-invalid="true"{% endif %}
            >
          </div>
          <a href="#recover" class="link customer__forgot">{{ 'customer.login_page.forgot_password' | t }}</a>
        {%- endif -%}
        <button type="submit" class="button button--full">{{ 'customer.login_page.sign_in' | t }}</button>
        <p class="customer__alt">
          {{ 'customer.login_page.no_account' | t }}
          <a href="{{ routes.account_register_url }}" class="link">{{ 'customer.login_page.create_account' | t }}</a>
        </p>
      {%- endform -%}

      {%- if shop.checkout.guest_login -%}
        <div class="customer__guest">
          <h2 class="h4">{{ 'customer.login_page.guest_title' | t }}</h2>
          {%- form 'guest_login' -%}
            <button type="submit" class="button button--secondary button--full">{{ 'customer.login_page.guest_continue' | t }}</button>
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer login",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ]
}
{% endschema %}
