{%- liquid
  assign s = section.settings
  assign form_id = 'NewsletterPopupForm-' | append: section.id
  assign show_here = false
  if s.enable
    if s.show_on == 'all' or template.name == 'index'
      assign show_here = true
    endif
  endif
  assign button_text = s.button_label
  if button_text == blank
    assign button_text = 'newsletter.button' | t
  endif
-%}
{%- if show_here or request.design_mode -%}
  <newsletter-popup
    class="newsletter-popup"
    data-enabled="{{ show_here }}"
    data-delay="{{ s.delay }}"
    data-frequency="{{ s.frequency }}"
    data-mobile="{{ s.show_on_mobile }}"
    data-exit-intent="{{ s.exit_intent }}"
    data-form-id="{{ form_id }}"
  >
    <dialog
      id="NewsletterPopup-{{ section.id }}"
      class="modal modal--popup color-{{ s.color_scheme }}"
      aria-labelledby="NewsletterPopupTitle-{{ section.id }}"
    >
      <button type="button" class="modal__close icon-button" data-dialog-close aria-label="{{ 'general.accessibility.close' | t }}">
        {%- render 'icon', icon: 'close' -%}
      </button>
      <div class="popup{% if s.image != blank %} popup--has-image popup--image-{{ s.image_position }}{% endif %}">
        {%- if s.image != blank -%}
          <div class="popup__media">
            {{
              s.image
              | image_url: width: 1200
              | image_tag: widths: '400, 600, 800, 1200', sizes: '(min-width: 750px) 22rem, 100vw', loading: 'lazy', alt: ''
            }}
          </div>
        {%- endif -%}
        <div class="popup__content">
          {%- if s.eyebrow != blank -%}
            <p class="eyebrow">{{ s.eyebrow | escape }}</p>
          {%- endif -%}
          <h2 id="NewsletterPopupTitle-{{ section.id }}" class="popup__heading h2">{{ s.heading | default: shop.name }}</h2>
          {%- if s.text != blank -%}
            <div class="popup__text rte">{{ s.text }}</div>
          {%- endif -%}

          {%- form 'customer', id: form_id, class: 'newsletter__form popup__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter,popup">
            {%- if form.posted_successfully? -%}
              <div class="popup__success" role="status" tabindex="-1" data-popup-success>
                <p class="form-message">
                  {%- render 'icon', icon: 'check' -%}
                  {{ 'newsletter.success' | t }}
                </p>
                {%- if s.discount_code != blank -%}
                  <copy-code class="promo__code popup__code" data-code="{{ s.discount_code | escape }}" data-copied="{{ 'sections.promo.copied' | t }}">
                    <span class="promo__code-label">{{ 'sections.promo.use_code' | t }}</span>
                    <code class="promo__code-value">{{ s.discount_code | escape }}</code>
                    <button type="button" class="link promo__code-copy" data-copy-button>
                      {{- 'sections.promo.copy' | t -}}
                      <span class="visually-hidden">: {{ s.discount_code | escape }}</span>
                    </button>
                  </copy-code>
                {%- endif -%}
              </div>
            {%- else -%}
              <div class="newsletter__field">
                <label class="visually-hidden" for="NewsletterPopupEmail-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
                <input
                  id="NewsletterPopupEmail-{{ section.id }}"
                  class="field__input newsletter__input"
                  type="email"
                  name="contact[email]"
                  value="{{ form.email }}"
                  placeholder="{{ 'newsletter.placeholder' | t }}"
                  autocomplete="email"
                  autocapitalize="off"
                  autocorrect="off"
                  required
                  {% if form.errors %}aria-invalid="true" aria-describedby="NewsletterPopupError-{{ section.id }}"{% endif %}
                >
                <button type="submit" class="button newsletter__button" name="commit">
                  {{- button_text | escape -}}
                </button>
              </div>
              {%- if form.errors -%}
                <p class="form-message form-message--error" id="NewsletterPopupError-{{ section.id }}" role="alert">
                  {%- render 'icon', icon: 'info' -%}
                  {{ form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email }}
                </p>
              {%- endif -%}
            {%- endif -%}
          {%- endform -%}

          {%- if s.disclaimer != blank -%}
            <div class="popup__disclaimer rte text-small text-muted">{{ s.disclaimer }}</div>
          {%- endif -%}
          <button type="button" class="link popup__dismiss" data-dialog-close>{{ 'newsletter.popup_dismiss' | t }}</button>
        </div>
      </div>
    </dialog>
  </newsletter-popup>
{%- endif -%}

{% schema %}
{
  "name": "Newsletter popup",
  "class": "newsletter-popup-section",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "enable", "label": "Enable popup", "default": true },
    {
      "type": "paragraph",
      "content": "In the editor the popup opens when this section is selected. Subscribers are added to your customers with the newsletter tag."
    },
    {
      "type": "select",
      "id": "show_on",
      "label": "Show on",
      "options": [
        { "value": "home", "label": "Home page only" },
        { "value": "all", "label": "All pages" }
      ],
      "default": "all"
    },
    { "type": "range", "id": "delay", "label": "Delay", "min": 2, "max": 60, "step": 1, "unit": "s", "default": 8 },
    { "type": "range", "id": "frequency", "label": "Show again after", "info": "Days before a visitor who closed the popup sees it again.", "min": 1, "max": 60, "step": 1, "unit": "d", "default": 14 },
    { "type": "checkbox", "id": "exit_intent", "label": "Also show when the visitor is about to leave", "info": "Desktop only.", "default": true },
    { "type": "checkbox", "id": "show_on_mobile", "label": "Show on mobile", "default": true },
    { "type": "header", "content": "Content" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Recommended: 4:5 portrait, 1000 x 1250 px." },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "end", "label": "Right" }
      ],
      "default": "start"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Join the list" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Take 10% off your first order" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>New arrivals, restocks and early access to the sale, straight to your inbox.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "discount_code", "label": "Discount code shown after signup", "info": "Create the code in Discounts first." },
    { "type": "richtext", "id": "disclaimer", "label": "Disclaimer", "default": "<p>You can unsubscribe at any time.</p>" }
  ],
  "presets": [{ "name": "Newsletter popup" }]
}
{% endschema %}
