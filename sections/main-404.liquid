<div
  class="section main-404 color-{{ section.settings.color_scheme }}{% unless section.settings.image_zoom %} zoom-off{% endunless %}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <header class="section-header section-header--center not-found">
      <div class="section-header__text">
        <p class="eyebrow">{{ 'templates.404.eyebrow' | t }}</p>
        <h1 class="h1">{{ section.settings.heading | escape }}</h1>
        {%- if section.settings.text != blank -%}
          <div class="rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
      <div class="section-header__actions not-found__actions">
        {%- if section.settings.show_search -%}
          <form action="{{ routes.search_url }}" method="get" role="search" class="not-found__search">
            <label class="visually-hidden" for="NotFoundSearch-{{ section.id }}">{{ 'search.general.label' | t }}</label>
            <input id="NotFoundSearch-{{ section.id }}" class="field__input" type="search" name="q" placeholder="{{ 'search.general.placeholder' | t }}">
            <input type="hidden" name="options[prefix]" value="last">
            <button type="submit" class="button">{{ 'search.general.title' | t }}</button>
          </form>
        {%- endif -%}
        <a href="{{ routes.all_products_collection_url }}" class="link">{{ 'templates.404.continue' | t }}{% render 'icon', icon: 'arrow-right' %}</a>
      </div>
    </header>

    {%- if section.settings.collection != blank and section.settings.collection.products.size > 0 -%}
      <div class="not-found__products">
        {%- if section.settings.products_heading != blank -%}
          <div class="section-header">
            <div class="section-header__text">
              <h2 class="h2">{{ section.settings.products_heading | escape }}</h2>
            </div>
          </div>
        {%- endif -%}
        <ul class="grid" role="list" style="--cols-desktop: 4; --cols-tablet: 3; --cols-mobile: 2;">
          {%- for product in section.settings.collection.products limit: 4 -%}
            <li>
              {% render 'product-card', product: product, sizes: '(min-width: 990px) 25vw, 50vw', section_id: section.id %}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "404 page",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "This page has moved on" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>The page you're looking for doesn't exist. Try a search or browse the latest arrivals.</p>" },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true },
    { "type": "collection", "id": "collection", "label": "Recommended products from" },
    { "type": "text", "id": "products_heading", "label": "Products heading", "default": "You might like" },
    { "type": "checkbox", "id": "image_zoom", "label": "Zoom images on hover", "info": "Works when Theme settings > Animations > Image hover effect uses zoom.", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ]
}
{% endschema %}
