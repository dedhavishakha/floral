{%- liquid
  if settings.currency_code_enabled
    assign subtotal = cart.total_price | money_with_currency
  else
    assign subtotal = cart.total_price | money
  endif
-%}
<div
  class="section main-cart color-{{ section.settings.color_scheme }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="cart-page" data-cart-section data-section-id="{{ section.id }}">
      <header class="section-header cart-page__header">
        <div class="section-header__text">
          <h1 class="h1" tabindex="-1">{{ 'cart.page.title' | t }}</h1>
        </div>
        {%- if cart.item_count > 0 -%}
          <div class="section-header__actions">
            <a href="{{ routes.all_products_collection_url }}" class="link">{{ 'cart.general.continue_shopping' | t }}</a>
          </div>
        {%- endif -%}
      </header>

      {%- if cart.item_count > 0 -%}
        <div class="cart-page__layout">
          <div class="cart-page__items">
            <div class="cart-page__labels" aria-hidden="true">
              <span>{{ 'cart.page.product' | t }}</span>
              <span>{{ 'cart.page.total' | t }}</span>
            </div>
            <ul class="cart-items cart-items--page" role="list" aria-label="{{ 'cart.general.items_label' | t }}">
              {%- for item in cart.items -%}
                {% render 'cart-line-item', item: item, index: forloop.index, image_width: 120 %}
              {%- endfor -%}
            </ul>
          </div>

          <aside class="cart-summary" aria-labelledby="CartSummaryTitle-{{ section.id }}">
            <h2 id="CartSummaryTitle-{{ section.id }}" class="h4">{{ 'cart.page.summary' | t }}</h2>

            {%- if section.settings.show_goals -%}
              {% render 'cart-goals' %}
            {%- endif -%}

            {%- if settings.cart_show_note -%}
              <div class="field cart-summary__note">
                <label class="field__label" for="CartPageNote-{{ section.id }}">{{ 'cart.general.note' | t }}</label>
                <textarea id="CartPageNote-{{ section.id }}" class="field__input" name="note" form="CartForm-{{ section.id }}" rows="3" data-cart-note>{{ cart.note }}</textarea>
              </div>
            {%- endif -%}

            {%- if cart.cart_level_discount_applications.size > 0 -%}
              <div class="cart-summary__row">
                <span>{{ 'cart.general.subtotal' | t }}</span>
                <span>{%- if settings.currency_code_enabled -%}{{ cart.items_subtotal_price | money_with_currency }}{%- else -%}{{ cart.items_subtotal_price | money }}{%- endif -%}</span>
              </div>
              <ul class="cart-discounts" role="list">
                {%- for discount in cart.cart_level_discount_applications -%}
                  <li>
                    {%- render 'icon', icon: 'tag' -%}
                    <span>{{ discount.title | escape }}</span>
                    <span>-{{ discount.total_allocated_amount | money }}</span>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}

            <div class="cart-summary__row cart-summary__row--total">
              <span>{%- if cart.cart_level_discount_applications.size > 0 -%}{{ 'cart.general.total' | t }}{%- else -%}{{ 'cart.general.subtotal' | t }}{%- endif -%}</span>
              <span>{{ subtotal }}</span>
            </div>
            <p class="cart-summary__note text-muted">
              {%- if cart.taxes_included -%}
                {{ 'cart.general.taxes_included_shipping_at_checkout' | t }}
              {%- else -%}
                {{ 'cart.general.taxes_and_shipping_at_checkout' | t }}
              {%- endif -%}
            </p>

            <form action="{{ routes.cart_url }}" method="post" id="CartForm-{{ section.id }}" class="cart-summary__form">
              <button type="submit" name="checkout" class="button button--full">
                {%- render 'icon', icon: 'lock' -%}
                {{ 'cart.general.checkout' | t }}
              </button>
            </form>

            {%- if additional_checkout_buttons -%}
              <div class="cart-summary__dynamic">{{ content_for_additional_checkout_buttons }}</div>
            {%- endif -%}

            {%- if section.settings.show_trust -%}
              <ul class="cart-summary__trust" role="list">
                <li>{% render 'icon', icon: 'lock' %}{{ 'cart.page.secure' | t }}</li>
                {%- if section.settings.returns_text != blank -%}
                  <li>{% render 'icon', icon: 'return' %}{{ section.settings.returns_text | escape }}</li>
                {%- endif -%}
              </ul>
            {%- endif -%}
          </aside>
        </div>
      {%- else -%}
        <div class="cart-page__empty">
          <p class="h3">{{ 'cart.general.empty' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'cart.general.continue_shopping' | t }}</a>
          {%- if shop.customer_accounts_enabled and customer == nil -%}
            <p class="text-muted">{{ 'cart.general.login_html' | t: link: routes.account_login_url }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Cart",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "show_goals", "label": "Show free shipping and gift progress", "info": "Set thresholds in Theme settings > Cart.", "default": true },
    { "type": "checkbox", "id": "show_trust", "label": "Show secure checkout note", "default": true },
    { "type": "text", "id": "returns_text", "label": "Returns note", "info": "Shown under the checkout button, for example your returns policy. Leave empty to hide." },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ]
}
{% endschema %}
