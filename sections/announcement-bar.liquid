{%- if section.blocks.size > 0 -%}
  <div
    class="announcement-bar color-{{ section.settings.color_scheme }}{% if section.settings.uppercase %} announcement-bar--uppercase{% endif %}{% if section.settings.sticky %} announcement-bar--sticky{% endif %}"
    style="--announcement-text: {{ section.settings.text_size }}px; --announcement-text-mobile: {{ section.settings.text_size_mobile }}px;"
    role="region"
    aria-label="{{ 'sections.announcement.label' | t }}"
  >
    <div class="announcement-bar__inner page-width{% if section.settings.full_width %} page-width--full{% endif %}">
      <div class="announcement-bar__side announcement-bar__side--start">
        {%- if section.settings.show_country -%}
          {% render 'localization-form', id_suffix: 'announcement', show_country: true, show_language: true, class: 'localization--compact' %}
        {%- endif -%}
        {%- if section.settings.show_social -%}
          {% render 'social-icons', class: 'social-icons--compact' %}
        {%- endif -%}
      </div>

      <announcement-bar class="announcement-bar__slider" data-speed="{% if section.settings.autoplay %}{{ section.settings.autoplay_speed }}{% else %}0{% endif %}">
        {%- if section.blocks.size > 1 -%}
          <button type="button" class="announcement-bar__arrow" data-announcement-prev aria-label="{{ 'sections.announcement.previous' | t }}">
            {%- render 'icon', icon: 'chevron-left' -%}
          </button>
        {%- endif -%}
        <div class="announcement-bar__slides" aria-live="off">
          {%- for block in section.blocks -%}
            <p class="announcement-bar__message" data-announcement {{ block.shopify_attributes }} {% unless forloop.first %}hidden{% endunless %}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="announcement-bar__link">
                  {{- block.settings.text -}}
                  {%- if block.settings.link_label != blank -%}
                    <span class="announcement-bar__cta">{{ block.settings.link_label | escape }}</span>
                  {%- endif -%}
                </a>
              {%- else -%}
                {{- block.settings.text -}}
              {%- endif -%}
            </p>
          {%- endfor -%}
        </div>
        {%- if section.blocks.size > 1 and section.settings.autoplay -%}
          <button
            type="button"
            class="announcement-bar__arrow announcement-bar__pause"
            data-announcement-pause
            aria-pressed="false"
            aria-label="{{ 'general.accessibility.pause' | t }}"
            data-label-pause="{{ 'general.accessibility.pause' | t }}"
            data-label-play="{{ 'general.accessibility.play' | t }}"
          >
            {%- render 'icon', icon: 'pause', class: 'announcement-bar__icon-pause' -%}
            {%- render 'icon', icon: 'play', class: 'announcement-bar__icon-play' -%}
          </button>
        {%- endif -%}
        {%- if section.blocks.size > 1 -%}
          <button type="button" class="announcement-bar__arrow" data-announcement-next aria-label="{{ 'sections.announcement.next' | t }}">
            {%- render 'icon', icon: 'chevron-right' -%}
          </button>
        {%- endif -%}
      </announcement-bar>

      <div class="announcement-bar__side announcement-bar__side--end">
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "announcement-section",
  "max_blocks": 8,
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" },
    { "type": "checkbox", "id": "sticky", "label": "Enable sticky bar", "info": "Keeps the bar at the top of the screen, above the header.", "default": false },
    { "type": "checkbox", "id": "autoplay", "label": "Auto rotate between messages", "info": "Rotation pauses on hover and focus.", "default": true },
    { "type": "range", "id": "autoplay_speed", "label": "Change messages every", "min": 3, "max": 12, "step": 1, "unit": "sec", "default": 5 },
    { "type": "range", "id": "text_size", "label": "Desktop text size", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "text_size_mobile", "label": "Mobile text size", "min": 10, "max": 18, "step": 1, "unit": "px", "default": 12 },
    { "type": "checkbox", "id": "uppercase", "label": "Uppercase text", "default": false },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "info": "Stretches the content to the screen edges instead of aligning it with the page width.", "default": false },
    { "type": "header", "content": "Extras" },
    { "type": "checkbox", "id": "show_country", "label": "Show country/region and language selectors", "info": "Add countries in Settings > Markets.", "default": false },
    { "type": "checkbox", "id": "show_social", "label": "Show social media icons", "default": false }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        { "type": "inline_richtext", "id": "text", "label": "Text", "default": "Free shipping on orders over $150" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "link_label", "label": "Link label", "info": "Shown underlined after the text." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [{ "type": "announcement" }]
    }
  ]
}
{% endschema %}
